@using HealthCheckAI.Helpers
@using HealthCheckAI.Models
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "修改報告";

    var groups = ViewBag.AiGroups as Dictionary<string, List<PatientFile>>
                 ?? new Dictionary<string, List<PatientFile>>();

    int selectedFileId = ViewBag.SelectedFileId is int v ? v : 0;
    string selectedPatient = ViewBag.SelectedPatient as string ?? "";
    string aiKeyPoints = ViewBag.AiKeyPointsPart as string ?? "";
    string aiSuggestions = ViewBag.AiSuggestionsPart as string ?? "";

    var parts = ViewBag.ReportParts as ReportParts ?? new ReportParts();

    // 取得當前檔案狀態，用於鎖定編輯權限
    var selectedFile = groups.Values.SelectMany(x => x).FirstOrDefault(f => f.Id == selectedFileId);
    bool isPublished = selectedFile?.IsPublishedToPublic ?? false;
    
    // 💡 鎖定條件：已上傳，或是已經有 AI 分析內容了
    bool isLocked = isPublished || !string.IsNullOrWhiteSpace(aiKeyPoints);

    // --- 表格資料準備與去重 ---
    var headers = new List<string>();
    var dynamicRows = new List<List<string>>();

    if ((parts.ReportType == ReportType.PhysicalExam || parts.ReportType == ReportType.SimplePhysical) && parts.TableRows != null)
    {
        // 自動去重：保留結果欄位最長的那一列
        parts.TableRows = parts.TableRows.GroupBy(r => r.Item)
                                        .Select(g => g.OrderByDescending(x => (x.Result ?? "").Length).First())
                                        .ToList();
    }

    if (parts.ReportType == ReportType.SimplePhysical)
    {
        headers = new List<string> { "項目", "結果" };
        dynamicRows = parts.TableRows?.Select(r => new List<string> { r.Item ?? "", r.Result ?? "" }).ToList() ?? new List<List<string>>();
    }
    else if (parts.ReportType == ReportType.PhysicalExam)
    {
        headers = new List<string> { "項目", "結果", "參考值" };
        dynamicRows = parts.TableRows?.Select(r => new List<string> { r.Item ?? "", r.Result ?? "", r.Reference ?? "" }).ToList() ?? new List<List<string>>();
    }
    else if (parts.ReportType == ReportType.Laboratory)
    {
        headers = new List<string> { "項目", "本次", "前次", "參考值" };
        dynamicRows = parts.TableRows?.Select(r => new List<string> { r.Item ?? "", r.Result ?? "", r.Previous ?? "", r.Reference ?? "" }).ToList() ?? new List<List<string>>();
    }
    else if (parts.ReportType == ReportType.Eye)
    {
        headers = new List<string> { "眼別", "視力裸視", "矯正視力", "眼壓(<21)", "電腦驗光", "散光", "辨色力" };
        dynamicRows = parts.TableRows?.Select(r => new List<string> { r.Item ?? "", r.Result ?? "", r.Previous ?? "", r.Reference ?? "", r.Extra1 ?? "", r.Extra2 ?? "", r.Extra3 ?? "" }).ToList() ?? new List<List<string>>();
    }

    bool hasDynamicTable = dynamicRows.Any();
    bool useRawTextBlock = parts.ReportType == ReportType.ECG || parts.ReportType == ReportType.Ultrasound;
    string previewRawText = parts.ReportType == ReportType.Ultrasound ? UltrasoundTextFormatter.Format(parts.TableRawText ?? "") : (parts.TableRawText ?? "");
}

@* --- functions 區塊維持不變 --- *@
@functions {
    public bool IsSectionTitle(string line) { /* ... 維持不變 ... */ return false; }
    public string FormatEyeDiagnosisHtml(string text) { /* ... 維持不變 ... */ return ""; }
    public string HighlightEyeAbnormalText(string text) { /* ... 維持不變 ... */ return ""; }
    public bool IsLabelLine(string line) { /* ... 維持不變 ... */ return false; }
    public bool IsUltrasoundAbnormalLine(string line) { /* ... 維持不變 ... */ return false; }
    public string GetUltrasoundLineClass(string line) { /* ... 維持不變 ... */ return "report-line"; }
}

<style>
    /* ... 既有樣式 ... */
    /* --- 側邊欄美化樣式 --- */
    .sidebar-wrapper {
        background-color: #2c3e50; /* 現代感的深藍灰色 */
        box-shadow: inset -3px 0 8px rgba(0,0,0,0.1);
    }

    .patient-sidebar-card {
        background: rgba(255, 255, 255, 0.08); /* 半透明背景 */
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        transition: all 0.2s ease-in-out;
    }

        .patient-sidebar-card:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.3);
        }

    .patient-name-badge {
        font-size: 1rem;
        color: #f8f9fa;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .custom-select-sidebar {
        font-size: 0.85rem;
        background-color: rgba(255, 255, 255, 0.95);
        border-radius: 8px;
        cursor: pointer;

    }
    .edit-card { border-radius: 16px; }
    .report-line { font-size: 1rem; line-height: 1.7; color: #333; margin-bottom: 4px; word-break: break-word; white-space: pre-wrap; font-weight: normal; }
    .us-title { font-size: 1.15rem; font-weight: 700; color: #111; margin-top: 14px; margin-bottom: 8px; line-height: 1.6; word-break: break-word; }
    .us-label { font-size: 1rem; font-weight: normal; color: #333; margin-top: 6px; margin-bottom: 4px; }
    .us-abnormal { font-size: 1rem; line-height: 1.7; color: #dc3545; font-weight: 400; margin-bottom: 4px; word-break: break-word; white-space: pre-wrap; }
    .section-label { display: inline-block; font-size: 1.05rem; font-weight: 700; color: #374151; margin-bottom: 8px; margin-top: 6px; }
    .edit-textarea { white-space: pre-wrap; font-size: 1rem; line-height: 1.7; border-radius: 10px; }
    .eye-table th { background-color: #f4f7fb; text-align: center; font-weight: 700; white-space: nowrap; }
    .eye-table td, .eye-table th { padding: 12px; vertical-align: middle; font-size: 1rem; }
    .eye-side-cell { font-weight: 700; background: #fafafa; white-space: nowrap; }
    .eye-diagnosis-editor { min-height: 220px; background: #fff; border: 1px solid #ced4da; border-radius: 10px; padding: 14px 16px; font-size: 1rem; line-height: 1.8; white-space: pre-wrap; overflow-y: auto; }
    .ultrasound-editor { min-height: 280px; background: #fff; border: 1px solid #ced4da; border-radius: 10px; padding: 14px 16px; font-size: 1rem; line-height: 1.7; white-space: normal; overflow-y: auto; }
    .ultrasound-editor:focus, .eye-diagnosis-editor:focus { outline: none; border-color: #86b7fe; box-shadow: 0 0 0 0.2rem rgba(13,110,253,.15); }
    .disabled-editor { background: #e9ecef; cursor: not-allowed; }
    .diagnosis-line { margin-bottom: 6px; color: #111; }
    .eye-abnormal-text { color: #dc3545; font-weight: 700; }
    .abnormal-highlight { background-color: #fff3cd !important; border-color: #dc3545 !important; cursor: pointer; }
    .source-hit { background-color: #fff3cd; color: #dc3545; font-weight: 700; padding: 1px 3px; border-radius: 4px; }
    .us-abnormal.abnormal-click { cursor: pointer; }
    .eye-abnormal-text.abnormal-click { cursor: pointer; }
    .source-hit-block { display: block; background-color: #fff3cd; color: #dc3545; font-weight: 700; padding: 4px 6px; border-radius: 6px; }

    /* 💡 新增鎖定樣式：滑鼠點擊無效、呈現灰色 */
    .locked-field {
        background-color: #e9ecef !important;
        cursor: not-allowed;
        overflow-y: auto !important; /* 強制開啟垂直捲軸功能 */
    }

    /* --- 強制按鈕層級 --- */
    .action-fixed-bar {
        position: relative;
        z-index: 9999 !important; /* 確保它永遠在最上面 */
        margin-top: 50px;
    }

</style>

<div class="container-fluid vh-100">
    <div class="row h-100">

        <!-- ========== 左側邊欄開始 ========== -->
        <div class="col-md-2 sidebar-wrapper text-white d-flex flex-column p-3" style="overflow-y:auto; overflow-x:hidden;">
            <h6 class="text-center mb-4 mt-2 fw-bold" style="letter-spacing: 1px; color: #a8d5ff;">
                🧾 AI 報告清單
            </h6>

            @if (!groups.Any())
            {
                <div class="text-center text-muted mt-4">
                    <div class="mb-2" style="font-size: 2rem; opacity: 0.5;">📁</div>
                    <small>目前尚無 AI 分析結果</small>
                </div>
            }
            else
            {
                foreach (var kv in groups)
                {
                    var patientName = kv.Key;
                    var files = kv.Value;

                    <div class="mb-3 p-3 patient-sidebar-card shadow-sm">

                        <!-- 病患名稱 -->
                        <div class="mb-2">
                            <span class="patient-name-badge fw-bold" title="@patientName">
                                👤 @patientName
                            </span>
                        </div>

                        <!-- 一鍵上傳按鈕 -->
                        <form method="post" asp-action="PublishAllForPatient" class="w-100 mb-2">
                            <input type="hidden" name="patientName" value="@patientName" />
                            <button type="submit" class="btn btn-success btn-sm w-100 shadow-sm" style="font-weight: 500;">
                                ☁️ 一鍵上傳
                            </button>
                        </form>

                        <!-- 下拉選單 -->
                        <select class="form-select custom-select-sidebar shadow-sm"
                                onchange="if(this.value){window.location.href='@Url.Action("EditReports", "Doctor")?fileId=' + this.value;}">
                            <option value="">📂 選擇報告...</option>
                            @foreach (var f in files)
                            {
                                var dateStr = $"{(f.UploadedAt == default(DateTime) ? f.UploadDate : f.UploadedAt):MM/dd HH:mm}";
                                var label = $"{f.Department} - {dateStr}";

                                if (f.Id == selectedFileId)
                                {
                                    <option value="@f.Id" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@f.Id">@label</option>
                                }
                            }
                        </select>
                    </div>
                }
            }
        </div>
        <!-- ========== 左側邊欄結束 ========== -->
        <!-- ========== 右側內容開始 ========== -->

        <div class="col-md-10 p-4 bg-light" style="overflow:auto;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="text-primary">👨‍⚕️ 來賓報告：@(string.IsNullOrEmpty(selectedPatient) ? "（請從左側選擇報告）" : selectedPatient)</h4>
                <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Doctor")">返回首頁</a>
            </div>

            <form method="post" asp-action="EditReports">
                <input type="hidden" name="fileId" value="@selectedFileId" />
                <input type="hidden" name="selectedPatient" value="@selectedPatient" />
                <pre id="originalText" style="display:none;">@ViewBag.OriginalExtractedText</pre>

                <div class="card shadow-sm mb-4 edit-card">
                    <div class="card-body">
                        @* 編輯區塊 *@
                        @if (useRawTextBlock)
                        {
                            @if (parts.ReportType == ReportType.Ultrasound)
                            {
                                <label class="section-label">報告編輯</label>
                                
                                // (省略你原本生成 usHtml 的複雜迴圈，這裡假設已經生成)
                                var usHtml = new System.Text.StringBuilder(); 
                                usHtml.Append(previewRawText); // 這裡僅為示意，請保留你原本的 usHtml 生成邏輯

                                <div id="ultrasoundEditor"
                                     @* 💡 套用 isLocked 變數 *@
                                     class="ultrasound-editor mb-3 @(selectedFileId == 0 ? "disabled-editor" : "") @(isLocked ? "disabled-editor locked-field" : "")"
                                     contenteditable="@(selectedFileId == 0 || isLocked ? "false" : "true")">
                                    @Html.Raw(usHtml.ToString())
                                </div>
                                <input type="hidden" name="tableRawText" id="ultrasoundHidden" value="@previewRawText" />
                            }
                            else
                            {
                                <textarea name="tableRawText" 
                                          @* 💡 套用 isLocked 變數 *@
                                          class="form-control mb-3 edit-textarea @(isLocked ? "locked-field" : "")" 
                                          rows="12" 
                                          @(selectedFileId == 0 ? "disabled" : (isLocked ? "readonly" : null))>@previewRawText</textarea>
                            }
                        }
                        else if (hasDynamicTable)
                        {
                            <table class="table table-bordered table-sm">
                                <thead>
                                    <tr>
                                        @foreach (var h in headers) { <th>@h</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < dynamicRows.Count; i++)
                                    {
                                        <tr>
                                            @for (int j = 0; j < headers.Count; j++)
                                            {
                                                var value = j < dynamicRows[i].Count ? dynamicRows[i][j] : "";
                                                bool isAbnormal = false;
                                                var rowObj = parts.TableRows[i];

                                                if (j == 1 && !string.IsNullOrWhiteSpace(rowObj.Result))
                                                {
                                                    // 1. 預設先用系統原本的判定 (比對數值與參考值)
                                                    isAbnormal = AbnormalHelper.IsAbnormal(rowObj.Result, rowObj.Reference);

                                                    // 2. 💡 修正：只有純文字描述的「簡易理學檢查」(SimplePhysical) 才需要用文字 fallback 判定
                                                    if (parts.ReportType == ReportType.SimplePhysical)
                                                    {
                                                        string cleanRes = rowObj.Result.Trim();
                                                        if (cleanRes != "正常" && cleanRes != "無明顯異常" && cleanRes != "未見異常")
                                                        {
                                                            isAbnormal = true; // 強制開啟大紅燈！🔴
                                                        }
                                                        else
                                                        {
                                                            isAbnormal = false; // 強制關閉大紅燈
                                                        }
                                                    }
                                                    // 3. 💡 修正：如果是「體格檢查(PhysicalExam)」或「實驗室(Laboratory)」
                                                    // 只要參考值是空的，就代表該項目沒有異常定義（如：身高、公式），絕對不可標示為異常！
                                                    else if (string.IsNullOrWhiteSpace(rowObj.Reference))
                                                    {
                                                        isAbnormal = false; // 強制關閉大紅燈 ⚪
                                                    }
                                                }

                                                <td class="@(parts.ReportType == ReportType.Eye && j == 0 ? "eye-side-cell" : "")">
                                                    <input name="cellValues"
                                                           class="form-control form-control-sm @(isAbnormal ? "text-danger fw-bold abnormal-click abnormal-highlight" : "") @(isLocked ? "locked-field" : "")"
                                                           data-keyword="@(isAbnormal? value : "")"
                                                           value="@value"
                                                           spellcheck="false"
                                                           autocomplete="off"
                                                           readonly="@isLocked"
                                                           disabled="@(selectedFileId == 0 && !isLocked)" />
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <hr />
                        
                        <label class="section-label">內容摘要</label>
                        <textarea name="keyPoints"
                        class="form-control mb-3 edit-textarea @(isPublished ? "locked-field" : "")"
                        rows="6"
                        readonly="@isPublished"
                        disabled="@(selectedFileId == 0 && !isPublished)">@aiKeyPoints</textarea>

                        <label class="section-label">健康建議</label>
                        <textarea name="suggestions"
                        class="form-control edit-textarea @(isPublished ? "locked-field" : "")"
                        rows="7"
                        readonly="@isPublished"
                        disabled="@(selectedFileId == 0 && !isPublished)">@aiSuggestions</textarea>
                    </div>
                </div>

                @* 動作區塊 *@
                <div class="d-flex justify-content-end gap-3 action-fixed-bar">
                    @if (isPublished)
                    {
                        <div class="alert alert-warning w-100 text-center">
                            <i class="fas fa-lock"></i> 報告已發布，無法進行任何編輯。
                        </div>
                    }
                    else
                    {
                        <button type="submit"
                                name="actionType"
                                value="save"
                                class="btn btn-warning"
                                @(selectedFileId == 0 ? "disabled" : null)>
                            編輯(暫存)
                        </button>

                        <button type="submit"
                                name="actionType"
                                value="upload"
                                class="btn btn-success"
                                @(selectedFileId == 0 ? "disabled" : null)>
                            上傳來賓端
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // ... (原有的 sourceTooltip 邏輯) ...

        function escapeHtml(text) {
            if (!text) return "";
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    });
</script>