@using HealthCheckAI.Helpers
@using HealthCheckAI.Models
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "修改報告";

    var groups = ViewBag.AiGroups as Dictionary<string, List<PatientFile>>
                 ?? new Dictionary<string, List<PatientFile>>();

    int selectedFileId = ViewBag.SelectedFileId is int v ? v : 0;
    string selectedPatient = ViewBag.SelectedPatient as string ?? "";
    string aiBeforeText = ViewBag.AiBeforeText as string ?? "";
    string aiKeyPoints = ViewBag.AiKeyPointsPart as string ?? "";
    string aiSuggestions = ViewBag.AiSuggestionsPart as string ?? "";

    var parts = ViewBag.ReportParts as ReportParts ?? new ReportParts();

    var headers = new List<string>();
    var dynamicRows = new List<List<string>>();

    if (parts.ReportType == ReportType.SimplePhysical)
    {
        headers = new List<string> { "項目", "結果" };

        dynamicRows = parts.TableRows != null
            ? parts.TableRows.Select(r => new List<string>
                    {
                r.Item ?? "",
                r.Result ?? ""
                    }).ToList()
            : new List<List<string>>();
    }
    else if (parts.ReportType == ReportType.PhysicalExam)
    {
        headers = new List<string> { "項目", "結果", "參考值" };

        dynamicRows = parts.TableRows != null
            ? parts.TableRows.Select(r => new List<string>
                    {
                r.Item ?? "",
                r.Result ?? "",
                r.Reference ?? ""
                    }).ToList()
            : new List<List<string>>();
    }
    else if (parts.ReportType == ReportType.Laboratory)
    {
        headers = new List<string> { "項目", "本次", "前次", "參考值" };

        dynamicRows = parts.TableRows != null
            ? parts.TableRows.Select(r => new List<string>
                    {
                r.Item ?? "",
                r.Result ?? "",
                r.Previous ?? "",
                r.Reference ?? ""
                    }).ToList()
            : new List<List<string>>();
    }
    else if (parts.ReportType == ReportType.Eye)
    {
        headers = new List<string> { "眼別", "視力裸視", "矯正視力", "眼壓(<21)", "電腦驗光", "散光", "辨色力" };

        dynamicRows = parts.TableRows != null
            ? parts.TableRows.Select(r => new List<string>
                    {
                r.Item ?? "",
                r.Result ?? "",
                r.Previous ?? "",
                r.Reference ?? "",
                r.Extra1 ?? "",
                r.Extra2 ?? "",
                r.Extra3 ?? ""
                    }).ToList()
            : new List<List<string>>();
    }
    else
    {
        headers = new List<string>();
        dynamicRows = new List<List<string>>();
    }

    int columnCount = headers.Count;
    bool hasDynamicTable = dynamicRows.Any();

    bool useRawTextBlock =
        parts.ReportType == ReportType.ECG ||
        parts.ReportType == ReportType.Ultrasound;

    string previewRawText = parts.TableRawText ?? "";

    if (parts.ReportType == ReportType.Ultrasound)
    {
        previewRawText = UltrasoundTextFormatter.Format(previewRawText);
    }
}

@functions {
    public bool IsSectionTitle(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return false;

        string[] titles =
        {
            "頸動脈超音波檢查",
            "甲狀腺超音波檢查",
            "腹部超音波",
            "心臟超音波檢查",
            "乳房超音波檢查",
            "婦科超音波檢查",
            "肝纖維化掃描"
    };

        var cleaned = line.Replace("【", "").Replace("】", "").Trim();
        return titles.Contains(cleaned);
    }

    public string FormatEyeDiagnosisHtml(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        var lines = text.Replace("\r\n", "\n").Replace("\r", "\n").Split('\n');
        var html = new System.Text.StringBuilder();

        foreach (var raw in lines)
        {
            var line = raw?.Trim() ?? "";
            if (string.IsNullOrWhiteSpace(line))
                continue;

            html.Append("<div class='diagnosis-line'>");

            if (line.Contains("："))
            {
                var idx = line.IndexOf('：');
                var left = line.Substring(0, idx + 1);
                var right = line.Substring(idx + 1);

                right = HighlightEyeAbnormalText(right);

                html.Append(System.Net.WebUtility.HtmlEncode(left));
                html.Append(right);
            }
            else
            {
                html.Append(HighlightEyeAbnormalText(line));
            }

            html.Append("</div>");
        }

        return html.ToString();
    }

    public string HighlightEyeAbnormalText(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        var encoded = System.Net.WebUtility.HtmlEncode(text);

        string[] normalKeywords =
        {
            "無明顯異常",
            "正常範圍",
            "正常",
            "Within normal limits"
    };

        if (normalKeywords.Any(k => text.Contains(k)))
            return encoded;

        string[] abnormalKeywords =
        {
            "近視",
            "散光",
            "視力異常",
            "異常",
            "Myopia",
            "Astigmatism",
            "visual abnormal"
    };

        foreach (var keyword in abnormalKeywords.OrderByDescending(x => x.Length))
        {
            encoded = System.Text.RegularExpressions.Regex.Replace(
                encoded,
                System.Text.RegularExpressions.Regex.Escape(System.Net.WebUtility.HtmlEncode(keyword)),
                $"<span class='eye-abnormal-text abnormal-click' data-keyword='{keyword}' contenteditable='false'>{keyword}</span>"
            );
        }

        return encoded;
    }

    public bool IsLabelLine(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return false;

        return line.Contains("診斷")
            || line.Contains("建議")
            || line.Contains("乳房影像診斷分級");
    }

    public bool IsUltrasoundAbnormalLine(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return false;

        var t = line.Trim();

        if (IsSectionTitle(t) || IsLabelLine(t))
            return false;

        string[] normalKeywords =
        {
            "無明顯異常",
            "正常",
            "大小正常",
            "收縮功能正常",
            "等級：正常",
            "無局部"
    };

        if (normalKeywords.Any(k => t.Contains(k)))
            return false;

        string[] abnormalKeywords =
        {
            "囊腫",
            "鈣化",
            "脂肪肝",
            "結節",
            "血管瘤",
            "副脾",
            "閉鎖不全",
            "追蹤",
            "異常",
            "病灶"
    };

        return abnormalKeywords.Any(k => t.Contains(k));
    }

    public string GetUltrasoundLineClass(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return "report-line";

        if (IsSectionTitle(line)) return "us-title";
        if (IsLabelLine(line)) return "us-label";
        if (IsUltrasoundAbnormalLine(line)) return "us-abnormal";

        return "report-line";
    }
}

<style>
    .edit-card {
        border-radius: 16px;
    }

    .report-line {
        font-size: 1rem;
        line-height: 1.7;
        color: #333;
        margin-bottom: 4px;
        word-break: break-word;
        white-space: pre-wrap;
        font-weight: normal;
    }

    .us-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #111;
        margin-top: 14px;
        margin-bottom: 8px;
        line-height: 1.6;
        word-break: break-word;
    }

    .us-label {
        font-size: 1rem;
        font-weight: normal;
        color: #333;
        margin-top: 6px;
        margin-bottom: 4px;
    }

    .us-abnormal {
        font-size: 1rem;
        line-height: 1.7;
        color: #dc3545;
        font-weight: 400;
        margin-bottom: 4px;
        word-break: break-word;
        white-space: pre-wrap;
    }

    .section-label {
        display: inline-block;
        font-size: 1.05rem;
        font-weight: 700;
        color: #374151;
        margin-bottom: 8px;
        margin-top: 6px;
    }

    .edit-textarea {
        white-space: pre-wrap;
        font-size: 1rem;
        line-height: 1.7;
        border-radius: 10px;
    }

    .eye-table th {
        background-color: #f4f7fb;
        text-align: center;
        font-weight: 700;
        white-space: nowrap;
    }

    .eye-table td,
    .eye-table th {
        padding: 12px;
        vertical-align: middle;
        font-size: 1rem;
    }

    .eye-side-cell {
        font-weight: 700;
        background: #fafafa;
        white-space: nowrap;
    }

    .eye-diagnosis-editor {
        min-height: 220px;
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: 10px;
        padding: 14px 16px;
        font-size: 1rem;
        line-height: 1.8;
        white-space: pre-wrap;
        overflow-y: auto;
    }

    .ultrasound-editor {
        min-height: 280px;
        background: #fff;
        border: 1px solid #ced4da;
        border-radius: 10px;
        padding: 14px 16px;
        font-size: 1rem;
        line-height: 1.7;
        white-space: normal;
        overflow-y: auto;
    }

        .ultrasound-editor:focus,
        .eye-diagnosis-editor:focus {
            outline: none;
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13,110,253,.15);
        }

    .disabled-editor {
        background: #e9ecef;
        cursor: not-allowed;
    }

    .diagnosis-line {
        margin-bottom: 6px;
        color: #111;
    }

    .eye-abnormal-text {
        color: #dc3545;
        font-weight: 700;
    }

    .abnormal-highlight {
        background-color: #fff3cd !important;
        border-color: #dc3545 !important;
        cursor: pointer;
    }

    .source-hit {
        background-color: #fff3cd;
        color: #dc3545;
        font-weight: 700;
        padding: 1px 3px;
        border-radius: 4px;
    }

    .us-abnormal.abnormal-click {
        cursor: pointer;
    }

    .eye-abnormal-text.abnormal-click {
        cursor: pointer;
    }

    .source-hit-block {
        display: block;
        background-color: #fff3cd;
        color: #dc3545;
        font-weight: 700;
        padding: 4px 6px;
        border-radius: 6px;
    }
</style>

<div class="container-fluid vh-100">
    <div class="row h-100">
        <div class="col-md-2 bg-secondary text-white d-flex flex-column p-3" style="overflow:auto;">
            <h5 class="text-center mb-3">🧾 AI分析完成</h5>

            @if (!groups.Any())
            {
                <div class="text-center small text-light">目前尚無 AI 分析結果</div>
            }
            else
            {
                foreach (var kv in groups)
                {
                    var patientName = kv.Key;
                    var files = kv.Value;

                    <div class="mb-3 p-2 bg-dark bg-opacity-25 rounded">
                        <div class="fw-bold mb-1 d-flex justify-content-between align-items-center">
                            <span>@patientName</span>

                            <form method="post" asp-action="PublishAllForPatient" class="ms-2">
                                <input type="hidden" name="patientName" value="@patientName" />
                                <button type="submit" class="btn btn-sm btn-success">一鍵上傳</button>
                            </form>
                        </div>

                        <select class="form-select form-select-sm mt-2"
                                onchange="if(this.value){window.location.href='@Url.Action("EditReports", "Doctor")?fileId=' + this.value;}">
                            <option value="">選擇報告</option>
                            @foreach (var f in files)
                            {
                                var label = $"{f.Department} - {(f.UploadedAt == default(DateTime) ? f.UploadDate : f.UploadedAt):yyyy/MM/dd HH:mm}";
                                if (f.Id == selectedFileId)
                                {
                                    <option value="@f.Id" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@f.Id">@label</option>
                                }
                            }
                        </select>
                    </div>
                }
            }
        </div>

        <div class="col-md-10 p-4 bg-light" style="overflow:auto;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="text-primary">
                    👨‍⚕️ 來賓報告：@(string.IsNullOrEmpty(selectedPatient) ? "（請從左側選擇報告）" : selectedPatient)
                </h4>
                <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Doctor")">返回首頁</a>
            </div>

            <form method="post" asp-action="EditReports">
                <input type="hidden" name="fileId" value="@selectedFileId" />
                <input type="hidden" name="selectedPatient" value="@selectedPatient" />

                <pre id="originalText" style="display:none;">@ViewBag.OriginalExtractedText</pre>

                <div class="card shadow-sm mb-4 edit-card">
                    <div class="card-body">

                        @if (useRawTextBlock)
                        {
                            if (parts.ReportType == ReportType.Ultrasound)
                            {
                                <label class="section-label">報告編輯</label>

                                var usLines = previewRawText
                                .Replace("\r\n", "\n")
                                .Replace("\r", "\n")
                                .Split('\n')
                                .Select(x => x.Trim())
                                .Where(x => !string.IsNullOrWhiteSpace(x))
                                .ToList();

                                var usHtml = new System.Text.StringBuilder();

                                for (int i = 0; i < usLines.Count; i++)
                                {
                                    var cleanLine = usLines[i];

                                    if (cleanLine == "極" && i + 1 < usLines.Count)
                                    {
                                        var next = usLines[i + 1].Trim();
                                        if (next.Contains("脂肪肝"))
                                        {
                                            cleanLine = cleanLine + next;
                                            i++;
                                        }
                                    }

                                    if (cleanLine.StartsWith("頸動脈：") && i + 1 < usLines.Count)
                                    {
                                        var next = usLines[i + 1].Trim();

                                        if (next.StartsWith("無明顯異常椎動脈："))
                                        {
                                            cleanLine = "頸動脈：無明顯異常 椎動脈： 無明顯異常";
                                            i++;
                                        }
                                    }

                                    if (cleanLine == "【" || cleanLine == "】")
                                        continue;

                                    cleanLine = cleanLine.Replace("【", "").Replace("】", "").Trim();

                                    if (cleanLine == "報告")
                                        continue;

                                    cleanLine = cleanLine.Replace("診斷（Diagnosis）", "診斷（Diagnosis）");
                                    cleanLine = cleanLine.Replace("診斷 (Diagnosis)", "診斷（Diagnosis）");
                                    cleanLine = cleanLine.Replace("建議（Suggestion）", "建議（Suggestion）");
                                    cleanLine = cleanLine.Replace("建議 (Suggestion)", "建議（Suggestion）");

                                    cleanLine = cleanLine.Replace("無明顯異常椎動脈：", "無明顯異常　椎動脈：");
                                    cleanLine = cleanLine.Replace("正常脂肪肝等級：", "正常　脂肪肝等級：");

                                    if (cleanLine == "頸動脈：" && i + 1 < usLines.Count)
                                    {
                                        var next = usLines[i + 1].Replace("【", "").Replace("】", "").Trim();

                                        if (next.StartsWith("無明顯異常椎動脈："))
                                        {
                                            cleanLine = "頸動脈：" + next.Replace("無明顯異常椎動脈：", "無明顯異常　椎動脈：");
                                            i++;
                                        }
                                    }

                                    if (cleanLine.StartsWith("肝纖維化等級：") && i + 1 < usLines.Count)
                                    {
                                        var next = usLines[i + 1].Replace("【", "").Replace("】", "").Trim();

                                        if (next.StartsWith("正常脂肪肝等級："))
                                        {
                                            cleanLine = "肝纖維化等級：正常　脂肪肝等級：正常";
                                            i++;
                                        }
                                    }

                                    var cls = GetUltrasoundLineClass(cleanLine);

                                    if (IsSectionTitle(cleanLine))
                                    {
                                        cleanLine = $"【{cleanLine}】";
                                        cls = "us-title";
                                    }

                                    var encodedLine = System.Net.WebUtility.HtmlEncode(cleanLine);

                                    if (cls == "us-abnormal")
                                    {
                                        usHtml.Append($"<div class='{cls} abnormal-click' data-keyword='{encodedLine}'>{encodedLine}</div>");
                                    }
                                    else
                                    {
                                        usHtml.Append($"<div class='{cls}'>{encodedLine}</div>");
                                    }
                                }

                                <div id="ultrasoundEditor"
                                     class="ultrasound-editor mb-3 @(selectedFileId == 0 ? "disabled-editor" : "")"
                                     contenteditable="@(selectedFileId == 0 ? "false" : "true")">
                                    @Html.Raw(usHtml.ToString())
                                </div>

                                <input type="hidden" name="tableRawText" id="ultrasoundHidden" value="@previewRawText" />
                                <input type="hidden" name="columnCount" value="0" />
                            }
                            else
                            {
                                <textarea name="tableRawText"
                                          class="form-control mb-3 edit-textarea"
                                          rows="12"
                                          placeholder="請在此編輯報告內容..."
                                          spellcheck="false"
                                @(selectedFileId == 0 ? "disabled" : null)>@previewRawText</textarea>

                                <input type="hidden" name="columnCount" value="0" />
                            }
                        }
                        else if (hasDynamicTable)
                        {
                            <label class="section-label">報告編輯</label>

                            @if (parts.ReportType == ReportType.Eye)
                            {
                                <label class="section-label">診斷內容</label>

                                <div id="eyeDiagnosisEditor"
                                     class="eye-diagnosis-editor mb-3 @(selectedFileId == 0 ? "disabled-editor" : "")"
                                     contenteditable="@(selectedFileId == 0 ? "false" : "true")">
                                    @Html.Raw(FormatEyeDiagnosisHtml(parts.TableRawText ?? ""))
                                </div>

                                <input type="hidden" name="tableRawText" id="eyeDiagnosisHidden" value="@parts.TableRawText" />
                            }

                            
                            <div class="table-responsive mb-3">
                                <table class="table table-bordered table-sm text-center align-middle @(parts.ReportType == ReportType.Eye ? "eye-table" : "")" id="dynamicTable">
                                    <thead>
                                        <tr>
                                            @for (int i = 0; i < headers.Count; i++)
                                            {
                                                <th>@headers[i]</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < dynamicRows.Count; i++)
                                        {
                                            <tr>
                                                @for (int j = 0; j < headers.Count; j++)
                                                {
                                                    var value = j < dynamicRows[i].Count ? dynamicRows[i][j] : "";

                                                    bool isResultColumn =
                                                    (parts.ReportType == ReportType.SimplePhysical && j == 1) ||
                                                    (parts.ReportType == ReportType.PhysicalExam && j == 1) ||
                                                    (parts.ReportType == ReportType.Laboratory && j == 1);

                                                    string reference = "";

                                                    if (parts.ReportType == ReportType.PhysicalExam && dynamicRows[i].Count > 2)
                                                    {
                                                        reference = dynamicRows[i][2];
                                                    }

                                                    if (parts.ReportType == ReportType.Laboratory && dynamicRows[i].Count > 3)
                                                    {
                                                        reference = dynamicRows[i][3];
                                                    }

                                                    bool isAbnormal = false;

                                                    if (isResultColumn)
                                                    {
                                                        isAbnormal = AbnormalHelper.IsAbnormal(value, reference);
                                                    }

                                                    if (parts.ReportType == ReportType.Eye && j == 1)
                                                    {
                                                        if (double.TryParse(value, out var v))
                                                        {
                                                            if (v < 0.7)
                                                                isAbnormal = true;
                                                        }
                                                    }

                                                    if (parts.ReportType == ReportType.Eye)
                                                    {
                                                        string[] eyeNormalKeywords =
                                                        {
                                        "無明顯異常",
                                        "正常",
                                        "正常範圍",
                                        "Within normal limits"
                                                                    };

                                                        string[] eyeAbnormalKeywords =
                                                        {
                                        "近視",
                                        "散光",
                                        "視力異常",
                                        "異常",
                                        "Myopia",
                                        "Astigmatism",
                                        "abnormal"
                                                                    };

                                                        if (!eyeNormalKeywords.Any(k => value.Contains(k)) &&
                                                        eyeAbnormalKeywords.Any(k => value.Contains(k)))
                                                        {
                                                            isAbnormal = true;
                                                        }
                                                    }

                                                    <td class="@(parts.ReportType == ReportType.Eye && j == 0 ? "eye-side-cell" : "")">
                                                        <input name="cellValues"
                                                               class="form-control form-control-sm @(isAbnormal ? "text-danger fw-bold abnormal-click abnormal-highlight" : "")"
                                                               data-keyword="@(isAbnormal ? value : "")"
                                                               value="@value"
                                                               spellcheck="false"
                                                               autocomplete="off"
                                                        @(selectedFileId == 0 ? "disabled" : null) />
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @if (parts.ReportType != ReportType.Eye)
                            {
                                <input type="hidden" name="tableRawText" value="" />
                            }

                            <input type="hidden" name="columnCount" value="@columnCount" />
                        }
                        else
                        {
                            <label class="section-label">報告編輯</label>
                            <textarea name="tableRawText"
                                      class="form-control mb-3 edit-textarea"
                                      rows="10"
                                      placeholder="請在此編輯報告內容..."
                                      spellcheck="false"
                            @(selectedFileId == 0 ? "disabled" : null)>@parts.TableRawText</textarea>

                            <input type="hidden" name="columnCount" value="0" />
                        }

                        <hr />

                        <label class="section-label">內容摘要</label>
                        <textarea name="keyPoints"
                                  class="form-control mb-3 edit-textarea"
                                  rows="6"
                                  placeholder="請在此編輯摘要內容..."
                                  spellcheck="false"
                        @(selectedFileId == 0 ? "disabled" : null)>@aiKeyPoints</textarea>

                        <label class="section-label">健康建議</label>
                        <textarea name="suggestions"
                                  class="form-control edit-textarea"
                                  rows="7"
                                  style="white-space:pre-wrap;"
                        @(selectedFileId == 0 ? "disabled" : null)>@aiSuggestions</textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3">
                    <button type="submit"
                            name="actionType"
                            value="save"
                            class="btn btn-warning"
                    @(selectedFileId == 0 ? "disabled" : null)>
                        編輯(暫存)
                    </button>

                    <button type="submit"
                            name="actionType"
                            value="upload"
                            class="btn btn-success"
                    @(selectedFileId == 0 ? "disabled" : null)>
                        上傳來賓端
                    </button>
                </div>
            </form>

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info mt-4">@TempData["Message"]</div>
            }

            <div id="sourceTooltip"
                 style="display:none;
                        position:absolute;
                        z-index:9999;
                        width:520px;
                        max-height:420px;
                        overflow:auto;
                        white-space:pre-wrap;
                        background:white;
                        border:1px solid #ddd;
                        border-radius:10px;
                        box-shadow:0 4px 16px rgba(0,0,0,.15);
                        padding:12px 14px;
                        font-size:14px;
                        line-height:1.6;">
                <div style="font-weight:700; margin-bottom:6px;">原始資料來源</div>
                <div id="sourceTooltipContent"></div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const sourceTextBox = document.getElementById("originalText");
        const tooltip = document.getElementById("sourceTooltip");
        const tooltipContent = document.getElementById("sourceTooltipContent");

        if (!sourceTextBox || !tooltip || !tooltipContent) return;

        const rawText = formatSourceText(sourceTextBox.textContent || "");

        document.querySelectorAll(".abnormal-click").forEach(function (el) {
        el.addEventListener("mousedown", function (e) {
            e.preventDefault();
            e.stopPropagation();

            const keyword = this.dataset.keyword?.trim();
            if (!keyword) return;

            tooltipContent.innerHTML = highlightSourceBlock(rawText, keyword);           
            const rect = this.getBoundingClientRect();

            tooltip.style.display = "block";
            tooltip.style.left = `${rect.right + window.scrollX + 10}px`;
            tooltip.style.top = `${rect.top + window.scrollY}px`;
        });
    });
            function formatSourceText(text) {
        let t = text
            .replace(/\r\n/g, "\n")
            .replace(/\r/g, "\n");

        t = t.replace(/(\d+\.\d+)\s*\n\s*(公分|cm)/g, "$1 $2");

        t = t.replace(/(\d+\.\d+)\s*(公分|cm)?\s*\n\s*[、,]\s*(\d+\.\d+)/g, "$1、$3");

        t = t.replace(/(\d+\.\d+)\s*\n\s*(\d+\.\d+)/g, "$1、$2");

        t = t.replace(/(\d+\.\d+(?:、\d+\.\d+)+)\s*(公分|cm)?/g, "$1 公分");

        t = t
            .replace(/診斷\s*\(?\s*Diagnosis\s*\)?/gi, "\n診斷（Diagnosis）")
            .replace(/建議\s*\(?\s*Suggestion\s*\)?/gi, "\n建議（Suggestion）")
            .replace(/報告/g, "\n報告")

            .replace(/頸動脈/g, "\n頸動脈")
            .replace(/椎動脈/g, "\n椎動脈")
            .replace(/左側/g, "\n左側")
            .replace(/右側/g, "\n右側")

            .replace(/脂肪肝/g, "\n脂肪肝")
            .replace(/囊腫/g, "\n囊腫")
            .replace(/結節/g, "\n結節")
            .replace(/血管瘤/g, "\n血管瘤")
            .replace(/鈣化/g, "\n鈣化")

            .replace(/[ \t]{2,}/g, " ")
            .replace(/\n{3,}/g, "\n\n")
            .trim();

        return t;
    }

        function highlightSourceBlock(text, keyword) {
        const lines = text
            .replace(/\r\n/g, "\n")
            .replace(/\r/g, "\n")
            .split("\n");

        const tokens = keyword
            .replace(/[：:，,、（）()\/]/g, " ")
            .split(/\s+/)
            .map(x => x.trim())
            .filter(x => x.length >= 2 || /^\d+(\.\d+)?$/.test(x));

        let hitIndex = -1;

        for (let i = 0; i < lines.length; i++) {
            const line = lines[i];

            const hitCount = tokens.filter(t => line.includes(t)).length;

            if (hitCount >= 1) {
                hitIndex = i;
                break;
            }
        }

        return lines.map((line, index) => {
            const safeLine = escapeHtml(line);

            if (index === hitIndex) {
                return `<mark class="source-hit-block">${safeLine}</mark>`;
            }

            return safeLine;
        }).join("\n");
    }

    function escapeHtml(text) {
        return text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
    }
    document.addEventListener("click", function (e) {
        if (e.target.closest(".abnormal-click")) return;
        if (e.target.closest("#sourceTooltip")) return;

        tooltip.style.display = "none";
    });

        tooltip.addEventListener("click", function (e) {
            e.stopPropagation();
        });


            function highlightKeywordsInFullText(text, keyword) {
        let safeText = escapeHtml(text);

        const tokens = keyword
            .replace(/[：:，,、（）()]/g, " ")
            .split(/\s+/)
            .map(x => x.trim())
            .filter(x => x.length >= 2 || /^\d+(\.\d+)?$/.test(x));

        tokens.forEach(function (token) {
            const escapedToken = token.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
            const regex = new RegExp(escapedToken, "gi");

            safeText = safeText.replace(regex, function (match) {
                return `<mark class="source-hit">${match}</mark>`;
            });
        });

        return safeText;
    }

    function escapeHtml(text) {
        return text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
    }

