@model IEnumerable<HealthCheckAI.Models.PatientFile>
@using HealthCheckAI.Helpers

@{
    ViewData["Title"] = "來賓上傳清單";
    var name = ViewBag.PatientName as string;
    var hasFileIds = ViewBag.HasFileIds as HashSet<int> ?? new HashSet<int>();
}

<div class="patient-container">
    <div class="page-header">
        <h3 class="page-title">📁 @name 的上傳紀錄</h3>

        <a class="btn btn-secondary back-btn" href="@Url.Action("Index", "Doctor")">返回醫師首頁</a>
    </div>

    <form method="post">
        <input type="hidden" name="name" value="@name" />
        <div class="top-action-bar">
            <div class="text-muted small top-tip">
                ※ 只有「已抽取文字且尚未上傳來賓端」的報告可以勾選進行批次 AI 分析。
            </div>

            <button type="submit"
                    class="btn batch-btn"
                    formaction="@Url.Action("BulkAnalyze", "Doctor")"
                    formmethod="post">
                🔁 批次 AI 分析（勾選項目）
            </button>
        </div>

        @if (Model != null && Model.Any())
        {
            var i = 1;
            foreach (var f in Model)
            {
                var canFile = hasFileIds.Contains(f.Id);
                var isPublished = f.IsPublishedToPublic;
                var canAnalyze = !isPublished && !string.IsNullOrWhiteSpace(f.ExtractedText);

                var extractedText = f.ExtractedText ?? "";
                var department = f.Department ?? "";
                var reportParts = !string.IsNullOrWhiteSpace(extractedText)
                ? ReportRenderHelper.Split(extractedText, department)
                : new ReportParts();

                <div class="record-card">
                    <div class="record-top">
                        <div class="record-left">
                            <div class="record-index">#@(i++)</div>
                            <div>
                                <div class="record-dept">@f.Department</div>
                                <div class="record-time">
                                    上傳時間：@((f.UploadedAt == null ? f.UploadDate : f.UploadedAt.Value).ToString("yyyy/MM/dd HH:mm"))
                                </div>
                            </div>
                        </div>

                        <div class="record-right">
                            <input type="checkbox"
                                   name="selectedIds"
                                   value="@f.Id"
                                   @(canAnalyze ? null : "disabled") />
                        </div>
                    </div>

                    <div class="record-actions">
                        @if (canFile)
                        {
                            <a class="btn action-btn action-preview" href="@Url.Action("Preview", "Doctor", new { id = f.Id })">👁 預覽</a>
                            <a class="btn action-btn action-download" href="@Url.Action("Download", "Doctor", new { id = f.Id })">⬇ 下載</a>
                        }
                        else
                        {
                            <button class="btn action-btn" disabled>👁 預覽</button>
                            <button class="btn action-btn" disabled>⬇ 下載</button>
                        }

                        <button type="submit"
                                class="btn action-btn action-extract"
                                formaction="@Url.Action("ExtractText", "Doctor")"
                                formmethod="post"
                                name="id"
                                value="@f.Id">
                            📝 抽取文字
                        </button>

                        @* 💡 【核心邏輯升級】：智慧分析按鈕判定 *@
                        @if (isPublished)
                        {
                            <!-- 1. 已經發布：直接導向 EditReports 查看鎖定畫面，不重複分析 -->
                            <a class="btn action-btn action-published" href="@Url.Action("EditReports", "Doctor", new { fileId = f.Id })">
                                ✅ 已上傳 (檢視)
                            </a>
                        }
                        else if (!string.IsNullOrWhiteSpace(f.AiSummary))
                        {
                            <!-- 2. 已有分析草稿：導向 EditReports 繼續編輯，防呆防覆蓋 -->
                            <a class="btn action-btn action-draft" href="@Url.Action("EditReports", "Doctor", new { fileId = f.Id })">
                                📝 編輯草稿
                            </a>
                        }
                        else
                        {
                            <!-- 3. 未分析過：顯示原本的 AI 分析按鈕 (POST 送去分析) -->
                            <button type="submit"
                                    class="btn action-btn action-ai"
                                    formaction="@Url.Action("AnalyzeText", "Doctor")"
                                    formmethod="post"
                                    name="id"
                                    value="@f.Id"
                                    @(canAnalyze ? null : "disabled")>
                                🤖 AI 分析
                            </button>
                        }

                        <input type="hidden" name="name" value="@ViewBag.PatientId" />

                        <button type="submit"
                                class="btn action-btn action-delete"
                                formaction="@Url.Action("Delete", "Doctor")"
                                formmethod="post"
                                name="id"
                                value="@f.Id"
                                onclick="return confirm('確認刪除這筆上傳？');">
                            🗑 刪除
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(f.ExtractedText))
                    {
                        <details class="record-detail">
                            <summary>已抽取的內容（展開查看）</summary>

                            @if (reportParts.TableRows != null && reportParts.TableRows.Any())
                            {
                                <table class="table table-bordered table-sm mt-3 text-center align-middle">
                                    <thead class="table-light">
                                        @if (reportParts.ReportType == ReportType.SimplePhysical)
                                        {
                                            <tr>
                                                <th>項目</th>
                                                <th>結果</th>
                                            </tr>
                                        }
                                        else if (reportParts.ReportType == ReportType.PhysicalExam)
                                        {
                                            <tr>
                                                <th>項目</th>
                                                <th>結果</th>
                                                <th>參考值</th>
                                            </tr>
                                        }
                                        else if (reportParts.ReportType == ReportType.Laboratory)
                                        {
                                            <tr>
                                                <th>檢查項目</th>
                                                <th>本次</th>
                                                <th>前次</th>
                                                <th>本次參考值</th>
                                            </tr>
                                        }
                                    </thead>
                                    <tbody>
                                        @foreach (var r in reportParts.TableRows)
                                        {
                                            if (r.IsSection)
                                            {
                                                var colspan = reportParts.ReportType == ReportType.Laboratory ? 4 :
                                                reportParts.ReportType == ReportType.PhysicalExam ? 3 : 2;

                                                <tr class="table-secondary">
                                                    <td colspan="@colspan" class="text-start fw-bold">@r.Item</td>
                                                </tr>
                                                continue;
                                            }

                                            if (reportParts.ReportType == ReportType.SimplePhysical)
                                            {
                                                <tr>
                                                    <td class="text-start">@r.Item</td>
                                                    <td>@r.Result</td>
                                                </tr>
                                            }
                                            else if (reportParts.ReportType == ReportType.PhysicalExam)
                                            {
                                                <tr>
                                                    <td class="text-start">@r.Item</td>
                                                    <td>@r.Result</td>
                                                    <td>@r.Reference</td>
                                                </tr>
                                            }
                                            else if (reportParts.ReportType == ReportType.Laboratory)
                                            {
                                                <tr>
                                                    <td class="text-start">@r.Item</td>
                                                    <td>@r.Result</td>
                                                    <td>@(string.IsNullOrWhiteSpace(r.Previous) ? "---" : r.Previous)</td>
                                                    <td>@r.Reference</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <textarea class="form-control mt-3"
                          rows="12"
                          readonly
                          style="white-space:pre-wrap; font-family:'Microsoft JhengHei', sans-serif;">@f.ExtractedText</textarea>
                            }
                        </details>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty-state">尚無上傳紀錄</div>
        }
    </form>
</div>

<style>
    .patient-container {
        max-width: 1150px;
        margin: 30px auto;
        padding: 0 20px 30px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1f3b64;
        margin: 0;
    }

    .back-btn {
        border-radius: 12px;
        padding: 10px 18px;
    }

    .record-card {
        background: #fff;
        border-radius: 18px;
        padding: 18px 20px;
        margin-bottom: 18px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
        border: 1px solid #e9eef6;
    }

    .record-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .record-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .record-index {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #eef3ff;
        color: #2b6ef2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .record-dept {
        font-size: 1.2rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 4px;
    }

    .record-time {
        color: #6b7280;
        font-size: 0.92rem;
    }

    .record-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 16px;
        align-items: center;
    }

    .record-detail {
        margin-top: 16px;
        background: #f8fbff;
        border-radius: 12px;
        padding: 12px 14px;
    }

        .record-detail summary {
            cursor: pointer;
            font-weight: 600;
            color: #334155;
        }

    .empty-state {
        background: white;
        border-radius: 16px;
        padding: 40px 20px;
        text-align: center;
        color: #6b7280;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
    }

    .top-action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .top-tip {
        margin: 0;
    }

    .batch-btn {
        background: linear-gradient(135deg, #18b7e6, #0ea5cf);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 700;
        box-shadow: 0 8px 18px rgba(14, 165, 207, 0.18);
    }

        .batch-btn:hover {
            color: white;
            opacity: 0.95;
        }

    .action-btn {
        border-radius: 12px;
        padding: 8px 14px;
        font-size: 0.9rem;
        font-weight: 600;
        transition: all 0.18s ease;
        box-shadow: 0 3px 8px rgba(15, 23, 42, 0.04);
        text-decoration: none; 
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .action-btn:hover {
            transform: translateY(-1px);
        }

    .action-preview {
        border: 1px solid #2b6ef2;
        color: #2b6ef2;
        background: #f4f8ff;
    }

    .action-download {
        border: 1px solid #16a34a;
        color: #15803d;
        background: #f0fdf4;
    }

    .action-extract {
        border: 1px solid #f59e0b;
        color: #b45309;
        background: #fff7ed;
    }

    .action-ai {
        border: 1px solid #06b6d4;
        color: #0e7490;
        background: #ecfeff;
    }

    /* 新增編輯草稿樣式 (高質感的溫馨橘黃色) */
    .action-draft {
        border: 1px solid #f59e0b;
        color: #d97706;
        background: #fffbeb;
    }

    .action-delete {
        border: 1px solid #ef4444;
        color: #dc2626;
        background: #fff1f2;
    }

    /* 已發布按鈕美化：現在可以點擊了，所以移除 cursor: default 改成 cursor: pointer */
    .action-published {
        background: #d1fae5;
        color: #047857;
        border: 1px solid #86efac;
        cursor: pointer;
    }

    .action-btn:disabled {
        opacity: 1;
    }
</style>

@section Scripts {
    <script>
        const checkboxes = document.querySelectorAll('input[name="selectedIds"]:not(:disabled)');
    </script>
}