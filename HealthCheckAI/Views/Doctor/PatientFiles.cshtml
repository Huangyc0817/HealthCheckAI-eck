@model IEnumerable<HealthCheckAI.Models.PatientFile>
@{
    ViewData["Title"] = "民眾上傳清單";
    var name = ViewBag.PatientName as string;
    var hasFileIds = ViewBag.HasFileIds as HashSet<int> ?? new HashSet<int>();
}

<div class="container mt-4">
    <h3 class="mb-3">📁 @name 的上傳紀錄</h3>

    <div class="text-end mb-3">
        <a class="btn btn-secondary" href="@Url.Action("Index","Doctor")">返回醫師首頁</a>
    </div>

    @* ▶ 只有一個 form，所有按鈕都共用這個 form *@
    <form method="post">
        <input type="hidden" name="name" value="@name" />

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:50px;">
                        <input type="checkbox" id="chkAll" />
                    </th>
                    <th>#</th>
                    <th>科別</th>
                    <th>上傳時間</th>
                    <th style="width:360px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    var i = 1;
                    foreach (var f in Model)
                    {
                        var canFile = hasFileIds.Contains(f.Id);                     // 有沒有實體檔案
                        var isPublished = f.IsPublishedToPublic;                     // ✅ 是否已上傳民眾端
                        var canAnalyze = !isPublished && !string.IsNullOrWhiteSpace(f.ExtractedText); // 可否 AI 分析

                        <tr>
                            <td>
                                @* 勾選用來批次 AI 分析（已上傳民眾端或沒文字都不能勾） *@
                                <input type="checkbox"
                                       name="selectedIds"
                                       value="@f.Id"
                                @(canAnalyze ? null : "disabled") />
                            </td>
                            <td>@(i++)</td>
                            <td>@f.Department</td>
                            <td>@(f.UploadedAt == default ? f.UploadDate : f.UploadedAt)</td>

                            <td>
                                @* 預覽/下載（超連結，跟 form 無關） *@
                                @if (canFile)
                                {
                                    <a class="btn btn-sm btn-outline-primary me-1"
                                       href="@Url.Action("Preview","Doctor", new { id = f.Id })">預覽</a>
                                    <a class="btn btn-sm btn-outline-success me-2"
                                       href="@Url.Action("Download","Doctor", new { id = f.Id })">下載</a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" disabled>預覽</button>
                                    <button class="btn btn-sm btn-outline-secondary me-2" disabled>下載</button>
                                }

                                @* 抽取文字：用 formaction 指向 ExtractText *@
                                <button type="submit"
                                        class="btn btn-sm btn-outline-warning me-2"
                                        formaction="@Url.Action("ExtractText","Doctor")"
                                        formmethod="post"
                                        name="id"
                                        value="@f.Id"
                                @(canFile ? null : "disabled")>
                                    抽取文字
                                </button>

                                @* 🤖 單筆 AI 分析：只有尚未上傳民眾端的才能用 *@
                                @if (!isPublished)
                                {
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-info me-2"
                                            formaction="@Url.Action("AnalyzeText","Doctor")"
                                            formmethod="post"
                                            name="id"
                                            value="@f.Id"
                                    @(canAnalyze ? null : "disabled")>
                                        AI 分析
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-success me-2" disabled>
                                        ✅ 已上傳民眾端
                                    </button>
                                }

                                @* 刪除：指向 Delete *@
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        formaction="@Url.Action("Delete","Doctor")"
                                        formmethod="post"
                                        name="id"
                                        value="@f.Id"
                                        onclick="return confirm('確認刪除這筆上傳？');">
                                    刪除
                                </button>
                            </td>
                        </tr>

                        @* 已抽取的文字（展開看） *@
                        @if (!string.IsNullOrWhiteSpace(f.ExtractedText))
                        {
                            <tr class="table-secondary">
                                <td></td>
                                <td colspan="5">
                                    <details class="mt-1">
                                        <summary>已抽取的文字（展開查看）</summary>
                                        <pre class="p-2 bg-light border rounded mt-2" style="white-space:pre-wrap;">@f.ExtractedText</pre>
                                    </details>
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">尚無上傳紀錄</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between mt-2">
            <div class="text-muted small">
                ※ 只有「已抽取文字且尚未上傳民眾端」的報告可以勾選進行批次 AI 分析。
            </div>
            @* 批次 AI 分析：送到 BulkAnalyze *@
            <button type="submit"
                    class="btn btn-info btn-sm"
                    formaction="@Url.Action("BulkAnalyze","Doctor")"
                    formmethod="post">
                🔁 批次 AI 分析（勾選項目）
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // 全選 / 取消全選（略過 disabled 的 checkbox）
        const chkAll = document.getElementById('chkAll');
        if (chkAll) {
            chkAll.addEventListener('change', function () {
                const checked = this.checked;
                document
                    .querySelectorAll('input[name="selectedIds"]:not(:disabled)')
                    .forEach(cb => cb.checked = checked);
            });
        }
    </script>
}
