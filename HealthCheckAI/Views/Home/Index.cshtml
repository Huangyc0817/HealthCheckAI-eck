@{
    ViewData["Title"] = "AI智能報告";
}

<div class="text-center mt-5" style="margin-top:70px;">
    <h1 class="display-4">AI智能報告</h1>
</div>

<div class="d-flex justify-content-center align-items-center" style="height:75vh">
    <div class="border rounded p-5 shadow" style="width:350px; background-color:white;">
        <h2 class="text-center mb-4">登入系統</h2>

        <form asp-action="Index" method="post">

            <div class="mb-3">
                <label>帳號</label>
                <input type="text" id="displayId" class="form-control" autocomplete="off" />
                <input type="hidden" id="realId" name="username" />
            </div>

            <div class="mb-3">
                <label>密碼</label>
                <input type="password" name="password" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success">登入</button>
            <a asp-action="Register" class="btn btn-secondary">註冊</a>

            <p class="text-danger mt-2">@ViewBag.Message</p>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const displayInput = document.getElementById("displayId");
            const realInput = document.getElementById("realId");

            if (!displayInput || !realInput) return;

            function mask(value) {
                if (value.length <= 4) return value;

                if (value.length <= 8) {
                    return value.substring(0, 4) + "*".repeat(value.length - 4);
                }

                return value.substring(0, 4) + "*".repeat(value.length - 6) + value.substring(value.length - 2);
            }

            function isValidNextChar(currentValue, key) {
                const len = currentValue.length;

                if (len === 0) {
                    return /^[A-Za-z]$/.test(key);
                }

                if (len >= 1 && len < 10) {
                    return /^[0-9]$/.test(key);
                }

                return false;
            }

            displayInput.addEventListener("keydown", function (e) {
                const key = e.key;

                if (
                    key === "Tab" ||
                    key === "Enter" ||
                    key === "ArrowLeft" ||
                    key === "ArrowRight" ||
                    key === "Home" ||
                    key === "End"
                ) {
                    return;
                }

                if (key === "Backspace") {
                    e.preventDefault();
                    realInput.value = realInput.value.slice(0, -1);
                    displayInput.value = mask(realInput.value);
                    return;
                }

                if (key === "Delete") {
                    e.preventDefault();
                    return;
                }

                if (isValidNextChar(realInput.value, key)) {
                    e.preventDefault();

                    if (realInput.value.length >= 10) return;

                    realInput.value += key.toUpperCase();
                    displayInput.value = mask(realInput.value);
                    return;
                }

                e.preventDefault();
            });

            displayInput.addEventListener("paste", function (e) {
                e.preventDefault();

                let pasted = (e.clipboardData || window.clipboardData).getData("text");
                pasted = pasted.toUpperCase().replace(/[^A-Z0-9]/g, "");

                let result = "";

                for (let i = 0; i < pasted.length && result.length < 10; i++) {
                    const ch = pasted[i];

                    if (result.length === 0) {
                        if (/^[A-Z]$/.test(ch)) {
                            result += ch;
                        }
                    } else {
                        if (/^[0-9]$/.test(ch)) {
                            result += ch;
                        }
                    }
                }

                realInput.value = result;
                displayInput.value = mask(realInput.value);
            });

            displayInput.addEventListener("input", function () {
                displayInput.value = mask(realInput.value);
            });
        });
    </script>
}