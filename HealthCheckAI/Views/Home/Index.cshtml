@{
    ViewData["Title"] = "AI智能健檢報告系統";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入系統 - HealthCheckAI</title>
    <!-- 引入與你原本系統一致的 Bootstrap 與 FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            font-family: 'Microsoft JhengHei', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: radial-gradient(circle at top left, #e3f2fd, #f8fbff, #eef5ff);
            overflow-x: hidden;
        }

        .login-fullscreen-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        /* 左側品牌區 */
        .brand-section {
            padding-right: 40px;
        }

        .system-badge {
            background: rgba(13, 110, 253, 0.08);
            color: #0d6efd;
            border: 1px solid rgba(13, 110, 253, 0.2);
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 20px;
        }

        .brand-title {
            font-size: 2.8rem;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        .brand-desc {
            color: #64748b;
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: 30px;
        }

        .feature-badges {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .feature-pill {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            color: #475569;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        /* 右側高質感登入卡片 */
        .login-card {
            background: rgba(255, 255, 255, 0.95);
            border: none;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08), 0 5px 15px rgba(0, 0, 0, 0.03);
            backdrop-filter: blur(10px);
            padding: 40px;
            position: relative;
        }

        /* 💡 右上角語言切換按鈕的專屬樣式 */
        .lang-btn {
            position: absolute;
            top: 25px;
            right: 25px;
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #64748b;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
        }

            .lang-btn:hover {
                border-color: #0d6efd;
                color: #0d6efd;
                background: #f8fafc;
            }

        .avatar-wrapper {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #e2f1ff, #bde0fe);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px auto;
            color: #0d6efd;
            font-size: 1.8rem;
            box-shadow: 0 8px 16px rgba(13, 110, 253, 0.12);
        }

        .card-title {
            font-weight: 700;
            color: #1e293b;
            font-size: 1.5rem;
        }

        .card-subtitle {
            color: #64748b;
            font-size: 0.9rem;
        }

        .form-label {
            font-weight: 600;
            color: #475569;
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        .input-wrapper {
            position: relative;
            width: 100%;
        }

        .mask-text {
            -webkit-text-security: disc;
            text-security: disc;
        }

        .custom-input {
            width: 100%;
            border: 2px solid #e2e8f0;
            background: #f8fafc !important;
            border-radius: 12px;
            padding: 12px 48px 12px 16px !important;
            font-size: 0.95rem;
            color: #1e293b;
            transition: all 0.2s ease-in-out;
        }

            .custom-input:focus {
                border-color: #0d6efd;
                background: #ffffff !important;
                box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
                outline: none;
            }

        .eye-toggle {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #64748b;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            z-index: 10;
            user-select: none;
            transition: color 0.2s;
        }

            .eye-toggle:hover {
                color: #0d6efd;
            }

        .btn-login {
            background: #0d6efd;
            color: #ffffff;
            border: none;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s;
            width: 100%;
        }

            .btn-login:hover {
                background: #0b5ed7;
                transform: translateY(-1px);
                box-shadow: 0 8px 15px rgba(13, 110, 253, 0.2);
            }

        .btn-register {
            background: #ffffff;
            color: #475569;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 12px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s;
            width: 100%;
            text-align: center;
            display: block;
            text-decoration: none;
        }

            .btn-register:hover {
                background: #f8fafc;
                border-color: #cbd5e1;
                color: #1e293b;
            }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row login-fullscreen-container align-items-center justify-content-center">

            <!-- 左側品牌區 -->
            <div class="col-lg-5 col-md-10 brand-section d-none d-lg-block offset-lg-1">
                <span class="system-badge">HealthCheckAI System</span>
                <h1 class="brand-title" data-translate>AI智能健檢報告系統</h1>
                <p class="brand-desc" data-translate>
                    結合健康檢查資料、AI 分析與報告管理，提供醫師與來賓更直覺、更有效率的健檢資料查看方式。
                </p>

                <div class="feature-badges">
                    <div class="feature-pill" data-translate>🩺 醫師報告管理</div>
                    <div class="feature-pill" data-translate>💬 AI 智能分析</div>
                    <div class="feature-pill" data-translate>📝 個人報告查看</div>
                </div>
            </div>

            <!-- 右側登入卡片區 -->
            <div class="col-lg-4 col-md-8 col-sm-10">
                <div class="card login-card">

                    <!-- 💡 語言切換按鈕，套用您原本的 lang-btn 樣式 -->
                    <button type="button" id="langToggleBtn" class="lang-btn">English</button>

                    <div class="text-center mb-4">
                        <div class="avatar-wrapper">🔑</div>
                        <h3 class="card-title mb-1" data-translate>登入系統</h3>
                        <p class="card-subtitle" data-translate>請輸入帳號與密碼以繼續使用系統</p>
                    </div>

                    <!-- 登入表單 -->
                    <form asp-action="Index" method="post">

                        <!-- 帳號輸入區 -->
                        <div class="mb-3">
                            <label class="form-label" data-translate>帳號</label>
                            <div class="input-wrapper">
                                <input type="text"
                                       name="username"
                                       id="usernameInput"
                                       class="form-control custom-input mask-text"
                                       placeholder="請輸入身分證字號或醫師證號"
                                       required
                                       autocomplete="off"
                                       data-translate />

                                <button type="button" class="eye-toggle" onclick="toggleFieldVisibility('usernameInput', this)" title="顯示/隱藏帳號">
                                    查看
                                </button>
                            </div>
                        </div>

                        <!-- 密碼輸入區  -->
                        <div class="mb-4">
                            <label class="form-label" data-translate>密碼</label>
                            <div class="input-wrapper">
                                <input type="password"
                                       name="password"
                                       id="passwordInput"
                                       class="form-control custom-input"
                                       placeholder="請輸入密碼"
                                       style="padding-right: 60px;"
                                       required
                                       autocomplete="new-password"
                                       data-translate />

                                <button type="button" class="eye-toggle" onclick="toggleFieldVisibility('passwordInput', this)" title="顯示/隱藏密碼">
                                    查看
                                </button>
                            </div>
                        </div>

                        <!-- 錯誤訊息提示區 -->
                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-danger py-2 rounded-3 mb-3 text-center" style="font-size: 0.85rem;" data-translate>
                                @Html.Raw(ViewBag.Message)
                            </div>
                        }

                        <button type="submit" class="btn btn-login mb-2" data-translate>登入</button>
                        <a href="@Url.Action("Register", "Home")" class="btn btn-register" data-translate>註冊</a>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <!-- 💡 將所有的 JavaScript 統一放在這裡 -->
    <script>
        // --- 密碼/帳號 顯示隱藏切換功能 ---
        function toggleFieldVisibility(inputId, buttonEl) {
            const inputField = document.getElementById(inputId);

            if (inputId === 'usernameInput') {
                if (inputField.classList.contains('mask-text')) {
                    inputField.classList.remove('mask-text');
                    buttonEl.innerHTML = "隱藏";
                } else {
                    inputField.classList.add('mask-text');
                    buttonEl.innerHTML = "查看";
                }
            } else {
                if (inputField.type === "password") {
                    inputField.type = "text";
                    buttonEl.innerHTML = "隱藏";
                } else {
                    inputField.type = "password";
                    buttonEl.innerHTML = "查看";
                }
            }
        }

        // --- 全域翻譯功能 ---
        let originalTexts = new Map();

        document.addEventListener("DOMContentLoaded", function () {
            const langToggleBtn = document.getElementById("langToggleBtn");

            // 取得目前的語言設定，預設為中文 (zh)
            let currentLang = localStorage.getItem("siteLang") || "zh";

            // 畫面載入時的初始化
            if (currentLang === "en") {
                langToggleBtn.innerText = "中文";
                translatePageTo("en");
            } else {
                langToggleBtn.innerText = "English";
            }

            // 點擊按鈕切換語言
            langToggleBtn.addEventListener("click", function () {
                if (currentLang === "zh") {
                    currentLang = "en";
                    langToggleBtn.innerText = "⏳ Translating...";
                    localStorage.setItem("siteLang", "en");
                    translatePageTo("en").then(() => {
                        langToggleBtn.innerText = "中文";
                    });
                } else {
                    currentLang = "zh";
                    localStorage.setItem("siteLang", "zh");
                    location.reload();
                }
            });
        });

        async function translatePageTo(targetLang) {
            const elements = document.querySelectorAll("[data-translate]");
            let textsToTranslate = [];
            let elementRefs = [];

            // 1. 先收集畫面上所有要翻譯的文字
            for (const el of elements) {
                const isInput = el.tagName === "INPUT";
                const original = originalTexts.get(el) || (isInput ? el.getAttribute("placeholder") : el.innerText.trim());

                if (!originalTexts.has(el)) {
                    originalTexts.set(el, original);
                }

                if (original) {
                    textsToTranslate.push(original); // 把文字裝進袋子裡
                    elementRefs.push(el);            // 記住這個文字是屬於哪個 HTML 元素的
                }
            }

            if (textsToTranslate.length === 0) return;

            try {
                // 2. 💡 只發送「1次」請求給後端，並把整包文字送過去 (注意網址多了 /batch)
                const response = await fetch("/api/translate/batch", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ texts: textsToTranslate, target: targetLang })
                });

                if (response.ok) {
                    const data = await response.json();
                    const translatedTexts = data.translatedTexts;

                    // 3. 收到翻譯好的陣列後，依序貼回畫面上
                    for (let i = 0; i < elementRefs.length; i++) {
                        const el = elementRefs[i];
                        const isInput = el.tagName === "INPUT";
                        const translatedText = translatedTexts[i];
                        const original = textsToTranslate[i];

                        if (isInput) {
                            el.setAttribute("placeholder", translatedText);
                        } else {
                            if (el.children.length > 0) {
                                el.innerHTML = el.innerHTML.replace(original, translatedText);
                            } else {
                                el.innerText = translatedText;
                            }
                        }
                    }
                } else {
                    const errorData = await response.text();
                    console.error("Gemini 翻譯失敗:", response.status, errorData);
                    alert("Gemini 翻譯失敗，請按 F12 查看錯誤！");
                }
            } catch (err) {
                console.error("網路請求失敗：", err);
            }
        }
    </script>
</body>
</html>