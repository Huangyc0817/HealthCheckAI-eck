@{
    ViewData["Title"] = "AI 健康診斷報告";
}

<h2 style="text-align:center;">🩺 您的 AI 健康診斷報告</h2>
<p style="text-align:center; color:gray;">根據您的健檢資料，AI 為您生成以下健康分析：</p>
<hr />

<div id="diagnosisArea"
     style="font-size:18px; line-height:1.8; margin:20px; white-space:pre-line;">

    <h4 class="text-primary">📌 Diagnosis A</h4>
    @ViewBag.DiagnosisA

    <hr />

    <h4 class="text-primary">📌 Diagnosis B</h4>
    @ViewBag.DiagnosisB

    <hr />

    <h4 class="text-primary">📌 Diagnosis C</h4>
    @ViewBag.DiagnosisC

    <hr />

    <h4 class="text-primary">📌 Diagnosis D</h4>
    @ViewBag.DiagnosisD

    <hr />

    <h4 class="text-primary">📌 Diagnosis E</h4>
    @ViewBag.DiagnosisE

    <hr />

    <h4 class="text-primary">📌 Diagnosis F</h4>
    @ViewBag.DiagnosisF

</div>

<div style="text-align:center; margin-top:20px;">
    <button onclick="playAll()" class="btn btn-success" style="font-size:16px; border-radius:10px;">
        🔊 播放完整報告
    </button>

    <br /><br />
    <audio id="audioPlayer" controls style="width:60%; display:none;"></audio>
</div>

<script>
    async function playAll() {
        const text = document.getElementById("diagnosisArea").innerText;
        const audioPlayer = document.getElementById("audioPlayer");

        const response = await fetch(`/TTS/Speak?text=${encodeURIComponent(text)}`);
        const blob = await response.blob();
        const url = URL.createObjectURL(blob);

        audioPlayer.src = url;
        audioPlayer.style.display = "block";
        audioPlayer.play();
    }

    // ✅ 可選：讓頁面開啟就自動播放
    window.onload = () => {
        playAll();
    };
</script>

