@using HealthCheckAI.Helpers
@{
    ViewData["Title"] = "理學檢查";

    var fullText = (ViewBag.DiagnosisB as string) ?? "";
    var department = (ViewBag.Department as string) ?? "理學檢查";
    var extractedText = (ViewBag.ExtractedText as string) ?? "";

    // 表格資料優先用抽取文字，沒有才退回全文
    var sourceText = !string.IsNullOrWhiteSpace(extractedText) ? extractedText : fullText;

    // 1. AI/邏輯產生的最終報告：拿來顯示內容摘要、重點整理、健康建議
    var aiParts = ReportRenderHelper.Split(fullText, department);

    // 2. 抽取文字：拿來顯示表格
    var tableParts = ReportRenderHelper.Split(sourceText, department);

    bool hasTable = tableParts.TableRows != null && tableParts.TableRows.Any();
    bool hasRawBlock = !string.IsNullOrWhiteSpace(tableParts.TableRawText);
    bool showBeforeText = !hasTable && !hasRawBlock;
}

<!-- 💡 這裡原本冗長的 <style> 已經移除，全面改用全站共用的 report-theme.css -->

<div class="container mt-4 mb-5">
    <h2 class="health-title" data-translate>@ViewData["Title"]</h2>

    <!-- 💡 卡片升級：換成 detail-card 享有立體陰影與圓角 -->
    <div class="detail-card mt-4">
        
        <!-- 頂部資訊區塊 -->
        <div class="row mb-4 pb-3" style="border-bottom: 2px dashed #e2e8f0;">
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="detail-label" data-translate>科別</div>
                <div class="detail-value" data-translate>@department</div>
            </div>
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="detail-label" data-translate>更新時間</div>
                <div class="detail-value" data-translate>@(ViewBag.PublishedAt ?? "－")</div>
            </div>
            <div class="col-md-4">
                <div class="detail-label" data-translate>需追蹤程度</div>
                <div class="detail-value text-danger" data-translate>@(ViewBag.AiSeverity ?? "－")</div>
            </div>
        </div>

        @if (showBeforeText && !string.IsNullOrWhiteSpace(aiParts.BeforeText))
        {
            <div class="section-subtitle" data-translate>📝 內容摘要</div>            
            <div class="translate-target content-text">
                @aiParts.BeforeText
            </div>
            <hr style="border-color: #e2e8f0; margin: 24px 0;" />
        }

        <div class="section-subtitle" data-translate>📋 檢查項目明細</div>
        
        @if (tableParts.TableRows != null && tableParts.TableRows.Any())
        {
            <!-- 💡 按鈕美化：套用一致的間距與樣式 -->
            <div class="d-flex justify-content-end mb-3 gap-2">
                <button class="btn btn-outline-primary btn-sm px-3" onclick="$('.collapse-target').collapse('show'); $('.category-header').removeClass('collapsed');" data-translate>展開全部</button>
                <button class="btn btn-outline-secondary btn-sm px-3" onclick="$('.collapse-target').collapse('hide'); $('.category-header').addClass('collapsed');" data-translate>收合全部</button>
            </div>

            <!-- 💡 表格升級：換成 table-modern 享有乾淨的質感灰線 -->
            <div class="custom-table-container table-responsive">
                <table class="table table-modern table-sm text-center align-middle">
                    <thead>
                        <tr>
                            <th style="width:36%;" data-translate>檢查項目</th>
                            <th style="width:18%;" data-translate>本次</th>
                            <th style="width:10%;" data-translate>前次</th>
                            <th style="width:36%;" data-translate>本次參考值</th>
                        </tr>
                    </thead>
                    
                    @{
                        string currentGroupId = "";
                        bool isFirstSection = true;
                    }
                    @foreach (var r in tableParts.TableRows)
                    {
                        if (r.IsSection)
                        {
                            if (!isFirstSection)
                            {
                                @:</tbody> 
                            }
                            isFirstSection = false;
                            currentGroupId = "group_" + Guid.NewGuid().ToString("N").Substring(0, 6);

                            <!-- 💡 分類標題列 -->
                            <tbody data-bs-toggle="collapse" data-bs-target="#@currentGroupId" aria-expanded="false" class="category-header collapsed">
                                <tr>
                                    <td colspan="4" class="text-start translate-target">
                                        <span class="toggle-icon">▼</span> @r.Item
                                    </td>
                                </tr>
                            </tbody>
                            <!-- 資料列 (預設隱藏) -->
                            @:<tbody id="@currentGroupId" class="collapse collapse-target">
                        }
                        else
                        {
                            if (isFirstSection)
                            {
                                isFirstSection = false;
                                currentGroupId = "group_default";
                                @:<tbody id="@currentGroupId" class="collapse collapse-target show">
                            }

                            var isAbnormal = AbnormalHelper.IsAbnormal(r.Result, r.Reference);

                            <tr>
                                <td class="text-start translate-target fw-bold text-dark">@r.Item</td>

                                <!-- 💡 異常值高亮 (配合共用 CSS 的 abnormal-bg) -->
                                <td class="translate-target fw-bold @(isAbnormal ? "abnormal-bg" : "")">
                                    @r.Result
                                </td>

                                <td class="translate-target text-muted">
                                    @(string.IsNullOrWhiteSpace(r.Previous) ? "---" : r.Previous)
                                </td>

                                <td class="translate-target text-muted">
                                    @r.Reference
                                </td>
                            </tr>
                        }
                    }
                    @if (!isFirstSection)
                    {
                        @:</tbody> 
                    }
                </table>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(tableParts.TableRawText))
        {
            <div class="translate-target content-text">
                @tableParts.TableRawText
            </div>
        }
        else
        {
            <div class="text-muted fst-italic p-4 text-center" style="background: #f8fafc; border-radius: 12px;" data-translate>
                目前尚無此科別醫師上傳的 AI 健檢報告。
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(aiParts.KeyPointsText))
        {
            <div class="section-subtitle mt-4" data-translate>💡 重點整理</div>            
            <div class="translate-target content-text report-text">
                @aiParts.KeyPointsText
            </div>
        }

        <!-- 💡 語音報告區塊：換成 ai-voice-box 泡泡框設計 -->
        <div class="ai-voice-box shadow-sm">
            <div class="ai-voice-title" data-translate>
                💬 AI 語音報告內容
            </div>
            <div class="ai-voice-content">@fullText</div>
            <div class="ai-voice-note" data-translate>
                ※ 本內容由 AI 分析與醫師審閱後提供，僅作健康管理參考，實際結果仍應以醫師專業判讀為準。
            </div>
        </div>

        <!-- 💡 語音控制面板：統一按鈕風格 -->
        <div class="voice-control-panel mt-2 mb-4">
            <div class="d-flex w-100 justify-content-between gap-3 flex-column flex-md-row">
                <button id="playButton" class="btn btn-voice btn-play-custom flex-grow-1 shadow-sm">
                    <span data-translate>▶ 播放報告</span>
                </button>
                <button id="pauseButton" class="btn btn-voice btn-pause-custom flex-grow-1 shadow-sm">
                    <span data-translate>⏸ 暫停</span>
                </button>
                <button id="stopButton" class="btn btn-voice btn-stop-custom flex-grow-1 shadow-sm">
                    <span data-translate>⏹ 停止</span>
                </button>
            </div>
        </div>

        <a class="btn btn-back-home w-100 mt-2" href="@Url.Action("Index", "Public")">
            <span data-translate>返回來賓主頁</span>
        </a>
    </div>
</div>

<script>
    // 💡 只需要把當前科別的語音文字存入全域變數，其他的播放/暫停邏輯都交給 report-features.js 處理
    window.currentReportText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fullText));
    
    // (翻譯功能若未抽離可暫時保留在此，建議未來也抽離到 _Layout.cshtml 中共用)
    let originalTexts = new Map();
    async function translateText(text, targetLang) {
        const response = await fetch("/api/translate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ text: text, source: "auto", target: targetLang })
        });
        if (!response.ok) throw new Error("翻譯失敗");
        const data = await response.json(); return data.translatedText;
    }
    async function translatePageToEnglish() {
        const elements = document.querySelectorAll("[data-translate], .translate-target");
        for (const el of elements) {
            const original = originalTexts.get(el) || el.innerText.trim();
            if (!originalTexts.has(el)) originalTexts.set(el, original);
            if (!original) continue;
            try { el.innerText = await translateText(original, "en"); } catch (err) {}
        }
    }
    document.addEventListener("DOMContentLoaded", function () {
        if (localStorage.getItem("siteLang") === "en") translatePageToEnglish();
    });
</script>