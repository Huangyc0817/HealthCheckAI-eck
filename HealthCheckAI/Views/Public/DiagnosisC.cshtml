@{
    ViewData["Title"] = "🧬 眼科檢查";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">🧬 眼科檢查</h2>

    <div class="card shadow-sm p-4">
        <h5 class="text-secondary">
            科別：@ViewBag.Department
        </h5>
        <p class="text-muted">
            更新時間：@(ViewBag.PublishedAt ?? "－")
        </p>
        <p class="text-muted">
            需追蹤程度：@(ViewBag.AiSeverity ?? "－")
        </p>
        <hr />

        <div id="reportText" style="white-space: pre-line; font-size:18px; line-height:1.8;">
            @(ViewBag.DiagnosisC ?? "目前尚無此科別醫師上傳的 AI 健檢報告。")
        </div>

        <div class="mt-3">

            <!-- 三顆語音按鈕：等寬、同一橫排 -->
            <div class="d-flex w-100" style="gap: 10px;">
                <button id="playButton" class="btn btn-success flex-grow-1">
                    🔊 播放報告
                </button>

                <button id="pauseButton" class="btn btn-warning flex-grow-1">
                    ⏸ 暫停
                </button>

                <button id="stopButton" class="btn btn-danger flex-grow-1">
                    ⛔ 停止
                </button>
            </div>

            <!-- 返回民眾主頁：跟上面同樣寬度 -->
            <a class="btn btn-secondary mt-4 w-100"
               href="@Url.Action("Index", "Public")">
                返回民眾主頁
            </a>
        </div>
    </div>
</div>
<script>
    let currentUtterance = null;

    // ▶ 播放
    document.getElementById("playButton")?.addEventListener("click", function () {
        const text = document.getElementById("reportText")?.innerText;
        if (!text) return;

        // 停止前一次朗讀
        speechSynthesis.cancel();

        currentUtterance = new SpeechSynthesisUtterance(text);
        currentUtterance.lang = "zh-TW";
        currentUtterance.rate = 1;

        speechSynthesis.speak(currentUtterance);

        // 恢復暫停按鈕文字
        const pauseBtn = document.getElementById("pauseButton");
        if (pauseBtn) pauseBtn.innerText = "⏸ 暫停";
    });

    // ⏸ 暫停 / ▶ 繼續
    document.getElementById("pauseButton")?.addEventListener("click", function () {
        if (!speechSynthesis.speaking) return;

        if (speechSynthesis.paused) {
            speechSynthesis.resume();
            this.innerText = "⏸ 暫停";
        } else {
            speechSynthesis.pause();
            this.innerText = "▶ 繼續";
        }
    });

    // ⛔ 停止（語音立即停止、歸零）
    document.getElementById("stopButton")?.addEventListener("click", function () {
        speechSynthesis.cancel();

        // 恢復暫停按鈕文字
        const pauseBtn = document.getElementById("pauseButton");
        if (pauseBtn) pauseBtn.innerText = "⏸ 暫停";
    });
</script>
