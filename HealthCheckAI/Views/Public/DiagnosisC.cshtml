@{
    ViewData["Title"] = "🧬 眼科檢查";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">🧬 眼科檢查</h2>

    <div class="card shadow-sm p-4">
        <h5 class="text-secondary">
            科別：@ViewBag.Department
        </h5>
        <p class="text-muted">
            更新時間：@(ViewBag.PublishedAt ?? "－")
        </p>
        <p class="text-muted">
            嚴重程度：@(ViewBag.AiSeverity ?? "－")
        </p>
        <hr />

        <p id="reportText">
            @(ViewBag.DiagnosisC ?? "目前尚無此科別醫師上傳的 AI 健檢報告。")
        </p>

        <button id="playButton" class="btn btn-success mt-3">
            🔊 播放報告
        </button>
        <a class="btn btn-secondary mt-4 ms-2" href="@Url.Action("Index", "Public")">返回民眾主頁</a>
    </div>
</div>
<script>
    document.getElementById("playButton")?.addEventListener("click", function () {
        const text = document.getElementById("reportText")?.innerText;
        if (!text) return;

        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = "zh-TW";
        utterance.rate = 1; // 可以微調語速
        speechSynthesis.speak(utterance);
    });
</script>