@using HealthCheckAI.Helpers
@{
    ViewData["Title"] = "靜態心電圖";

    var fullText = (ViewBag.DiagnosisD as string) ?? "";
    var department = (ViewBag.Department as string) ?? "靜態心電圖";
    var extractedText = (ViewBag.ExtractedText as string) ?? "";

    var sourceText = !string.IsNullOrWhiteSpace(extractedText) ? extractedText : fullText;

    var aiParts = ReportRenderHelper.Split(fullText, department);
    var tableParts = ReportRenderHelper.Split(sourceText, department);

    bool hasTable = tableParts.TableRows != null && tableParts.TableRows.Any();
    bool hasRawBlock = !string.IsNullOrWhiteSpace(tableParts.TableRawText);
    bool showBeforeText = !hasTable && !hasRawBlock;
}

<div class="container mt-4">
    <h2 class="text-primary mb-4" data-translate>靜態心電圖</h2>

    <div class="card shadow-sm p-4">
        <h5 class="text-secondary" data-translate>科別：@ViewBag.Department</h5>
        <p class="text-muted" data-translate>更新時間：@(ViewBag.PublishedAt ?? "－")</p>
        <p class="text-muted" data-translate>需追蹤程度：@(ViewBag.AiSeverity ?? "－")</p>
        <hr />

        @if (showBeforeText && !string.IsNullOrWhiteSpace(aiParts.BeforeText))
        {
            <h6 class="mt-2">內容摘要</h6>
            <div style="white-space: pre-line; font-size:18px; line-height:1.8;">
                @aiParts.BeforeText
            </div>
            <hr />
        }

        <h6 class="mt-2">ECG</h6>

        @if (!string.IsNullOrWhiteSpace(tableParts.TableRawText))
        {
            <div class="border rounded p-3 bg-light"
                 style="white-space: pre-wrap; font-size:18px; line-height:1.8;">
                @tableParts.TableRawText
            </div>
        }
        else
        {
            <div class="text-muted">目前尚無此科別醫師上傳的 AI 健檢報告。</div>
        }

        <hr />

        @if (!string.IsNullOrWhiteSpace(aiParts.KeyPointsText))
        {
            <h6 class="mt-2">重點整理</h6>
            <div style="white-space: pre-line; font-size:18px; line-height:1.8;">
                @aiParts.KeyPointsText
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(aiParts.SuggestionsText))
        {
            <h6 class="mt-3">健康建議</h6>
            <div style="white-space: pre-line; font-size:18px; line-height:1.8;">
                @aiParts.SuggestionsText
            </div>
        }

        <p class="text-muted mt-3" data-translate>
            ※ 本內容由 AI 分析與醫師審閱後提供，僅作健康管理參考。
        </p>

        <div class="mt-3">
            <div class="d-flex w-100" style="gap: 10px;">
                <button id="playButton" class="btn btn-success flex-grow-1">
                    <span data-translate>🔊 播放報告</span>
                </button>
                <button id="pauseButton" class="btn btn-warning flex-grow-1">
                    <span data-translate>⏸ 暫停</span>
                </button>
                <button id="stopButton" class="btn btn-danger flex-grow-1">
                    <span data-translate>⛔ 停止</span>
                </button>
            </div>

            <a class="btn btn-secondary mt-4 w-100" href="@Url.Action("Index", "Public")">
                <span data-translate>返回來賓主頁</span>
            </a>
        </div>
    </div>
</div>

<script>
    if (!window.__ttsBound) {
        window.__ttsBound = true;

        let currentUtterance = null;
        const fullText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fullText));

        document.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn) return;

            const id = btn.id;

            if (id === "playButton") {
                if (!fullText) return;
                speechSynthesis.cancel();

                currentUtterance = new SpeechSynthesisUtterance(fullText);
                currentUtterance.lang = "zh-TW";
                currentUtterance.rate = 1;
                speechSynthesis.speak(currentUtterance);

                const pauseBtn = document.getElementById("pauseButton");
                if (pauseBtn) pauseBtn.innerText = "⏸ 暫停";
            }

            if (id === "pauseButton") {
                if (!speechSynthesis.speaking) return;

                if (speechSynthesis.paused) {
                    speechSynthesis.resume();
                    btn.innerText = "⏸ 暫停";
                } else {
                    speechSynthesis.pause();
                    btn.innerText = "▶ 繼續";
                }
            }

            if (id === "stopButton") {
                speechSynthesis.cancel();
                const pauseBtn = document.getElementById("pauseButton");
                if (pauseBtn) pauseBtn.innerText = "⏸ 暫停";
            }
        });
    }
</script>