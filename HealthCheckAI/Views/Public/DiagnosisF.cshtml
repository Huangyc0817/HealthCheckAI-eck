@using HealthCheckAI.Helpers
@using System.Linq
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = "精密儀器檢查";

    var fullText = (ViewBag.DiagnosisF as string) ?? "";
    var department = (ViewBag.Department as string) ?? "精密儀器檢查";
    var extractedText = (ViewBag.ExtractedText as string) ?? "";

    var sourceText = !string.IsNullOrWhiteSpace(extractedText) ? extractedText : fullText;

    var aiParts = ReportRenderHelper.Split(fullText, department);
    var tableParts = ReportRenderHelper.Split(sourceText, department);

    bool hasTable = tableParts.TableRows != null && tableParts.TableRows.Any();
    bool hasRawBlock = !string.IsNullOrWhiteSpace(tableParts.TableRawText);
    bool showBeforeText = !hasTable && !hasRawBlock;

    string rawTextForDisplay = tableParts.TableRawText ?? "";
    rawTextForDisplay = UltrasoundTextFormatter.Format(rawTextForDisplay);
}

@functions {
    public bool IsInstrumentAbnormalLine(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return false;

        var t = line.Trim();

        string[] titleKeywords =
        {
            "頸動脈超音波檢查",
            "甲狀腺超音波檢查",
            "腹部超音波",
            "心臟超音波檢查",
            "乳房超音波檢查",
            "婦科超音波檢查",
            "肝纖維化掃描",
            "報告",
            "診斷（Diagnosis）",
            "診斷 (Diagnosis)",
            "建議（Suggestion）",
            "建議 (Suggestion)",
            "乳房影像診斷分級（BI-RADS category）",
            "乳房影像診斷分級(BI-RADS category)"
        };

        if (titleKeywords.Any(x => t.Contains(x)))
            return false;

        string[] normalKeywords =
        {
            "無明顯異常",
            "正常",
            "大小正常",
            "收縮功能正常",
            "等級：正常",
            "LVEF=75%"
        };

        if (normalKeywords.Any(x => t.Contains(x)))
            return false;

        string[] abnormalKeywords =
        {
            "囊腫",
            "鈣化",
            "脂肪肝",
            "結節",
            "血管瘤",
            "副脾",
            "閉鎖不全",
            "追蹤",
            "纖維化",
            "病灶"
        };

        return abnormalKeywords.Any(x => t.Contains(x));
    }

    public bool IsInstrumentTitleLine(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return false;

        string[] titles =
        {
            "頸動脈超音波檢查",
            "甲狀腺超音波檢查",
            "腹部超音波",
            "心臟超音波檢查",
            "乳房超音波檢查",
            "婦科超音波檢查",
            "肝纖維化掃描"
        };

        var cleaned = line.Replace("【", "").Replace("】", "").Trim();
        return titles.Contains(cleaned);
    }

    public bool IsInstrumentLabelLine(string line)
    {
        if (string.IsNullOrWhiteSpace(line)) return false;

        return line.Contains("報告")
            || line.Contains("診斷（Diagnosis）")
            || line.Contains("診斷 (Diagnosis)")
            || line.Contains("建議（Suggestion）")
            || line.Contains("建議 (Suggestion)")
            || line.Contains("乳房影像診斷分級（BI-RADS category）")
            || line.Contains("乳房影像診斷分級(BI-RADS category)");
    }
}

<style>
    .instrument-report-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #f8f9fa;
        padding: 18px 20px;
        font-size: 18px;
        line-height: 1.7;
        white-space: normal;
    }

    .instrument-line {
        color: #212529;
        margin: 0 0 8px 0;
        word-break: break-word;
    }

        .instrument-line.title-line {
            font-weight: 700;
            font-size: 1.45rem;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .instrument-line.label-line {
            font-weight: 700;
            font-size: 1.1rem;
            margin-top: 12px;
            margin-bottom: 6px;
        }

        .instrument-line.abnormal-line {
            color: #dc3545;
            font-weight: 700;
        }

        .instrument-line.title-line:first-child {
            margin-top: 0;
        }
</style>

<div class="container mt-4">
    <h2 class="text-primary mb-4" data-translate>精密儀器檢查</h2>

    <div class="card shadow-sm p-4">
        <h5 class="text-secondary" data-translate>科別：@ViewBag.Department</h5>
        <p class="text-muted" data-translate>更新時間：@(ViewBag.PublishedAt ?? "－")</p>
        <p class="text-muted" data-translate>需追蹤程度：@(ViewBag.AiSeverity ?? "－")</p>
        <hr />

        @if (showBeforeText && !string.IsNullOrWhiteSpace(aiParts.BeforeText))
        {
            <h6 class="mt-2" data-translate>內容摘要</h6>            
            <div class="translate-target" style="white-space: pre-line; font-size:18px; line-height:1.8;">
                @aiParts.BeforeText
            </div>
            <hr />
        }

        <h6 class="mt-2" data-translate>Imaging / Instrument Examination</h6>
        @if (!string.IsNullOrWhiteSpace(rawTextForDisplay))
        {
            <div style="
        font-size:16px;
        font-weight:400;
        line-height:1.3;
        white-space:pre-wrap;
        margin:0;
        padding:0;
    ">
                @{
                    var lines = rawTextForDisplay
                    .Replace("\r\n", "\n")
                    .Replace("\r", "\n")
                    .Split('\n');

                    foreach (var rawLine in lines)
                    {
                        var line = rawLine ?? "";

                        if (string.IsNullOrWhiteSpace(line))
                        {
                            <div>&nbsp;</div>
                            continue;
                        }

                        var css = "instrument-line";

                        if (IsInstrumentTitleLine(line))
                        {
                            css += " title-line";
                        }
                        else if (IsInstrumentLabelLine(line))
                        {
                            css += " label-line";
                        }
                        else if (IsInstrumentAbnormalLine(line))
                        {
                            css += " abnormal-line";
                        }

                        var cleanLine = line.Replace("【", "").Replace("】", "");

                        <div class="@css translate-target">@cleanLine</div>
                    }
                }
            </div>
        }
        else
        {
            <div class="text-muted" data-translate>
                目前尚無此科別醫師上傳的 AI 健檢報告。
            </div>
        }

        <hr />

        @if (!string.IsNullOrWhiteSpace(aiParts.KeyPointsText))
        {
            <h6 class="mt-2" data-translate>重點整理</h6>

            <div class="translate-target report-text" style="white-space: pre-line; font-size:18px; line-height:1.8;">
                @aiParts.KeyPointsText
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(aiParts.SuggestionsText))
        {
            <h6 class="mt-3" data-translate>健康建議</h6>            
            <div class="translate-target report-text" style="white-space: pre-line; font-size:18px; line-height:1.8;">
                @aiParts.SuggestionsText
            </div>
        }

        <p class="text-muted mt-3" data-translate>
            ※ 本內容由 AI 分析與醫師審閱後提供，僅作健康管理參考。
        </p>

        <div class="mt-3">
            <div class="d-flex w-100" style="gap: 10px;">
                <button id="playButton" class="btn btn-success flex-grow-1">
                    <span data-translate>🔊 播放報告</span>
                </button>
                <button id="pauseButton" class="btn btn-warning flex-grow-1">
                    <span data-translate>⏸ 暫停</span>
                </button>
                <button id="stopButton" class="btn btn-danger flex-grow-1">
                    <span data-translate>⛔ 停止</span>
                </button>
            </div>

            <a class="btn btn-secondary mt-4 w-100" href="@Url.Action("Index", "Public")">
                <span data-translate>返回來賓主頁</span>
            </a>
        </div>
    </div>
</div>

<script>
    if (!window.__ttsBound) {
        window.__ttsBound = true;

        let currentUtterance = null;
        const fullText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(fullText));

        document.addEventListener("click", function (e) {
            const btn = e.target.closest("button");
            if (!btn) return;

            const id = btn.id;

            if (id === "playButton") {
                speechSynthesis.cancel();

                let textToSpeak = fullText;
                let speakLang = "zh-TW";

    if (localStorage.getItem("siteLang") === "en") {                    
        textToSpeak = Array.from(document.querySelectorAll(".translate-target"))
                        .map(el => el.innerText.trim())
                        .filter(x => x)
                        .join("\n\n");

                    speakLang = "en-US";
                }

                if (!textToSpeak) return;

                currentUtterance = new SpeechSynthesisUtterance(textToSpeak);
                currentUtterance.lang = speakLang;
                currentUtterance.rate = 1;

                speechSynthesis.speak(currentUtterance);

                const pauseBtn = document.getElementById("pauseButton");
                if (pauseBtn) pauseBtn.innerText = "⏸ 暫停";
            }

            if (id === "pauseButton") {
                if (!speechSynthesis.speaking) return;

                if (speechSynthesis.paused) {
                    speechSynthesis.resume();
                    btn.innerText = "⏸ 暫停";
                } else {
                    speechSynthesis.pause();
                    btn.innerText = "▶ 繼續";
                }
            }

            if (id === "stopButton") {
                speechSynthesis.cancel();
                const pauseBtn = document.getElementById("pauseButton");
                if (pauseBtn) pauseBtn.innerText = "⏸ 暫停";
            }
        });
    }
        let originalTexts = new Map();

    async function translateText(text, targetLang) {
        const response = await fetch("/api/translate", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                text: text,
                source: "auto",
                target: targetLang
            })
        });

        if (!response.ok) {
            throw new Error("翻譯失敗");
        }

        const data = await response.json();
        return data.translatedText;
    }

    async function translatePageToEnglish() {
        const elements = document.querySelectorAll("[data-translate], .translate-target");

        for (const el of elements) {
            const original = originalTexts.get(el) || el.innerText.trim();

            if (!originalTexts.has(el)) {
                originalTexts.set(el, original);
            }

            if (!original) continue;

            try {
                const translated = await translateText(original, "en");
                el.innerText = translated;
            } catch (err) {
                console.error("翻譯失敗：", err);
            }
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        const savedLang = localStorage.getItem("siteLang") || "zh";

        if (savedLang === "en") {
            translatePageToEnglish();
        }
    });
   
</script>