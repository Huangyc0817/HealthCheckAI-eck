@model List<HealthCheckAI.Models.DeptSummaryViewModel>
@{
    ViewData["Title"] = "來賓主頁";
    var Name = Context.Session.GetString("Name");
}



<div class="row">
    <!-- 🟦 左側功能欄 -->
    <div class="col-md-3 col-lg-2">
        <div class="sidebar">
            <div>
                <div class="sidebar-profile">
                    <div class="profile-avatar">👤</div>
                    <div class="profile-name">@Name</div>
                    <div class="profile-role" data-translate>健康報告使用者</div>
                </div>

                <div class="sidebar-section-title" data-translate>功能選單</div>
                <ul class="sidebar-menu">
                    <li>
                        <a class="menu-item" href="@Url.Action("Summary", "Public")">
                            <span class="menu-icon">📊</span>
                            <span data-translate>綜合分析表</span>
                        </a>
                    </li>
                    <li>
                        <a class="menu-item" href="@Url.Action("DiagnosisA", "Public")">
                            <span class="menu-icon">🩺</span>
                            <span data-translate>體格檢查表</span>
                        </a>
                    </li>
                    <li>
                        <a class="menu-item" href="@Url.Action("DiagnosisB", "Public")">
                            <span class="menu-icon">💊</span>
                            <span data-translate>理學檢查</span>
                        </a>
                    </li>
                    <li>
                        <a class="menu-item" href="@Url.Action("DiagnosisC", "Public")">
                            <span class="menu-icon">🧬</span>
                            <span data-translate>眼科檢查</span>
                        </a>
                    </li>
                    <li>
                        <a class="menu-item" href="@Url.Action("DiagnosisD", "Public")">
                            <span class="menu-icon">⚡</span>
                            <span data-translate>靜態心電圖</span>
                        </a>
                    </li>
                    <li>
                        <a class="menu-item" href="@Url.Action("DiagnosisE", "Public")">
                            <span class="menu-icon">🧪</span>
                            <span data-translate>實驗室檢查</span>
                        </a>
                    </li>
                    <li>
                        <a class="menu-item" href="@Url.Action("DiagnosisF", "Public")">
                            <span class="menu-icon">🪢</span>
                            <span data-translate>精密儀器檢查</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-footer">
                <a class="logout-btn" href="@Url.Action("Index", "Home")">
                    <span>🚪</span>
                    <span data-translate>登出系統</span>
                </a>
            </div>
        </div>
    </div>
    <!-- 🟨 右側主內容區 -->
    <div class="col-md-9 col-lg-10 main-content">
        <div class="welcome-card">
            <h2 data-translate>👋 歡迎回來，@Context.Session.GetString("Name")</h2>
            <p data-translate>您可以從左側選擇「綜合分析表」或各單科「診斷與建議」，查看個人健康報告與 AI 分析結果。</p>
        </div>

        <div class="summary-cards">
            <div class="summary-card">
                <div class="summary-icon">📄</div>
                <div>
                    <div class="summary-label" data-translate>已發布報告</div>
                    <div class="summary-value">@ViewBag.ReportCount</div>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon">🚨</div>
                <div>
                    <div class="summary-label" data-translate>高風險項目</div>
                    <div class="summary-value">@ViewBag.HighRiskCount</div>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon">🕒</div>
                <div>
                    <div class="summary-label" data-translate>最新更新</div>
                    <div class="summary-value">@ViewBag.LastUpdated</div>
                </div>
            </div>
        </div>
        <div class="top-risk-list mt-4">
            <h4 data-translate>🔥 風險優先關注（Top 3）</h4>

            @{
                var topItem = Model?.FirstOrDefault();
            }
            @if (Model != null && Model.Any())
            {
                var top3 = Model.Take(3).ToList();

                @for (int i = 0; i < top3.Count; i++)
                {
                    var item = top3[i];

                    <a href="@Url.Action(GetAction(item.Department), "Public")" class="risk-item-link">
                        <div class="risk-item">
                            <div class="rank">@(i + 1)</div>

                            <div class="risk-content">
                                <div class="dept" data-translate>@item.Department</div>                                <div class="dept-en">@item.EnglishName</div>
                            </div>

                            <div class="risk-score">
                                @item.Score%
                            </div>

                            <div class="risk-badge @(item.Score >= 80 ? "high" : item.Score >= 50 ? "mid" : "low")"
                                 data-translate>
                                @(item.Score >= 80 ? "高" : item.Score >= 50 ? "中" : "低")
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="no-data" data-translate>尚無風險資料</div>
            }

            <a class="btn btn-primary mt-3" href="@Url.Action("Summary", "Public")" data-translate>
                查看完整分析 →
            </a>
        </div>
        @if (topItem != null)
        {
            <div class="top-risk-card mb-4">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="top-risk-label" data-translate>目前最需優先留意項目</div>
                        <div class="top-risk-dept" data-translate>@topItem.Department</div>                        <div class="top-risk-en">@topItem.EnglishName</div>
                        <div class="top-risk-note" data-translate>
                            建議優先查看此項目的 AI 分析摘要與醫師建議內容。
                        </div>
                    </div>

                    <div class="col-md-4 text-center">
                        <div class="top-risk-score">@topItem.Score%</div>
                        <div class="top-risk-grade">
                            @(topItem.Score >= 80 ? "A" :
                                                    topItem.Score >= 65 ? "B" :
                                                    topItem.Score >= 50 ? "C" :
                                                    topItem.Score >= 35 ? "D" :
                                                    topItem.Score >= 20 ? "E" : "F")
                    </div>
                        <span class="status-badge @(topItem.Score >= 80 ? "status-high" : topItem.Score >= 50 ? "status-medium" : "status-low")"
                              data-translate>
                            @(topItem.Score >= 80 ? "高風險" : topItem.Score >= 50 ? "中風險" : "低風險")
                        </span>
                    </div>
                </div>
            </div>
                }
        <div class="dashboard-grid">
            <div class="side-panel full-width-panel">
                <h4 data-translate>🔔 系統提醒</h4>
                <ul class="reminder-list">
                    <li data-translate>請優先查看高風險檢查項目</li>
                    <li data-translate>若有異常數值，建議諮詢醫師</li>
                    <li data-translate>可從左側進入各科詳細報告</li>
                </ul>
            </div>
        </div>
    </div>

    <style>
        /* 🔥 Top3 風險排行榜 */

        .top-risk-list {
            background: white;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.05);
        }

        .risk-item-link {
            text-decoration: none;
            color: inherit;
        }

        .risk-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px;
            border-radius: 14px;
            transition: 0.2s;
            margin-bottom: 10px;
        }

            .risk-item:hover {
                background: #f4f8ff;
                transform: translateX(5px);
            }

        .rank {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #e0eaff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: #1f6ef2;
        }

        .risk-content {
            flex: 1;
        }

        .dept {
            font-weight: 700;
            color: #1f3b64;
        }

        .dept-en {
            font-size: 0.85rem;
            color: #888;
        }

        .risk-score {
            font-weight: bold;
            font-size: 1.2rem;
            width: 60px;
            text-align: right;
        }

        .risk-badge {
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: bold;
        }

            .risk-badge.high {
                background: #ffe5e5;
                color: #d63031;
            }

            .risk-badge.mid {
                background: #fff3cd;
                color: #a06a00;
            }

            .risk-badge.low {
                background: #d9f3ff;
                color: #0077b6;
            }

        .no-data {
            color: #888;
        }
        .top-risk-card {
            background: linear-gradient(135deg, #eef4ff, #f8fbff);
            border: 1px solid #d9e6ff;
            border-radius: 18px;
            padding: 18px 22px;
            box-shadow: 0 8px 20px rgba(43, 110, 242, 0.08);
        }

        .top-risk-label {
            color: #6c757d;
            font-size: 0.95rem;
            margin-bottom: 6px;
        }

        .top-risk-dept {
            font-size: 1.3rem;
            font-weight: 700;
            color: #1f3b64;
        }

        .top-risk-en {
            color: #7c8aa5;
            font-size: 0.95rem;
            margin-bottom: 8px;
        }

        .top-risk-note {
            color: #495057;
            font-size: 0.9rem;
        }

        .top-risk-score {
            font-size: 1.8rem;
            font-weight: 800;
            color: #dc3545;
        }

        .top-risk-grade {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1f3b64;
            margin-bottom: 8px;
        }

        .status-badge {
            display: inline-block;
            min-width: 84px;
            padding: 8px 12px;
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .status-high {
            background-color: #fde2e5;
            color: #c82333;
        }

        .status-medium {
            background-color: #fff3cd;
            color: #a06a00;
        }

        .status-low {
            background-color: #d9f3ff;
            color: #0c7da0;
        }
        body {
            background: #f4f7fb;
        }

        .main-content {
            padding: 28px 32px;
        }

        .sidebar {
            min-height: calc(100vh - 120px);
            width: 100%;
            background: linear-gradient(180deg, #1f6ef2 0%, #185ed0 100%);
            color: white;
            border-radius: 24px;
            padding: 22px 18px;
            box-shadow: 0 10px 24px rgba(31, 110, 242, 0.18);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .sidebar-profile {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 18px;
            padding: 18px 14px;
            text-align: center;
            margin-bottom: 22px;
            backdrop-filter: blur(8px);
        }

        .profile-avatar {
            width: 58px;
            height: 58px;
            margin: 0 auto 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.20);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }

        .profile-name {
            font-size: 1.45rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .profile-role {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.82);
        }

        .sidebar-section-title {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.75);
            letter-spacing: 1px;
            margin-bottom: 10px;
            padding-left: 6px;
        }

        .sidebar-menu {
            list-style: none;
            padding-left: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: white;
            text-decoration: none;
            padding: 13px 14px;
            border-radius: 14px;
            transition: all 0.2s ease;
            font-size: 1rem;
            font-weight: 500;
        }

            .menu-item:hover {
                background: rgba(255,255,255,0.14);
                color: white;
                transform: translateX(4px);
            }

        .menu-icon {
            width: 24px;
            text-align: center;
            font-size: 1.1rem;
        }

        .sidebar-footer {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid rgba(255,255,255,0.16);
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            color: white;
            text-decoration: none;
            padding: 13px 14px;
            border-radius: 14px;
            background: rgba(255,255,255,0.08);
            transition: all 0.2s ease;
            font-weight: 600;
        }

            .logout-btn:hover {
                background: rgba(255,255,255,0.18);
                color: white;
            }

        .welcome-card {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
            margin-bottom: 22px;
        }

            .welcome-card h2 {
                font-size: 2rem;
                color: #1f2937;
                margin-bottom: 10px;
            }

            .welcome-card p {
                color: #6b7280;
                margin-bottom: 0;
                font-size: 1rem;
            }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 22px;
        }

        .summary-card {
            background: white;
            border-radius: 18px;
            padding: 20px;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .summary-icon {
            font-size: 1.8rem;
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: #eef4ff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .summary-label {
            color: #6b7280;
            font-size: 0.95rem;
        }

        .summary-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1f3b64;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .side-panel {
            background: white;
            border-radius: 18px;
            padding: 24px;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
        }

            .side-panel h4 {
                margin-bottom: 14px;
                color: #1f3b64;
                font-weight: 700;
            }

        .full-width-panel {
            min-height: 180px;
        }

        .reminder-list {
            margin: 0;
            padding-left: 18px;
            color: #4b5563;
        }

            .reminder-list li {
                margin-bottom: 10px;
            }

        @@media (max-width: 992px) {
            .summary-cards {
                grid-template-columns: 1fr;
            }

            .main-content {
                padding: 20px 16px;
            }

            .sidebar {
                min-height: auto;
                margin-bottom: 20px;
            }
        }
    </style>
    <script>
        let originalTexts = new Map();

        async function translateText(text, targetLang) {
            const response = await fetch("/api/translate", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    text: text,
                    source: "auto",
                    target: targetLang
                })
            });

            if (!response.ok) {
                throw new Error("翻譯失敗");
            }

            const data = await response.json();
            return data.translatedText;
        }

        async function translatePageToEnglish() {
            const elements = document.querySelectorAll("[data-translate], .translate-target");

            for (const el of elements) {
                const original = originalTexts.get(el) || el.innerText.trim();

                if (!originalTexts.has(el)) {
                    originalTexts.set(el, original);
                }

                if (!original) continue;

                try {
                    const translated = await translateText(original, "en");
                    el.innerText = translated;
                } catch (err) {
                    console.error("翻譯失敗：", err);
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const savedLang = localStorage.getItem("siteLang") || "zh";

            if (savedLang === "en") {
                translatePageToEnglish();
            }
        });
    </script>
@functions {
    public string GetAction(string dept)
    {
        return dept switch
        {
            "體格檢查表" => "DiagnosisA",
            "理學檢查" => "DiagnosisB",
            "眼科檢查" => "DiagnosisC",
            "靜態心電圖" => "DiagnosisD",
            "實驗室檢查" => "DiagnosisE",
            "精密儀器檢查" => "DiagnosisF",
            _ => "Summary"
        };
    }
}
