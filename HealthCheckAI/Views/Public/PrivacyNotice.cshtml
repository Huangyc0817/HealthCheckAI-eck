@{
    ViewBag.Title = "隱私權說明";
}

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-4" style="max-width: 700px; width:100%; border-radius:15px;">

        <!-- 標題 -->
        <h2 class="text-center mb-2 fw-bold"
            data-i18n
            data-zh="🩺 隱私權說明"
            data-en="🩺 Privacy Notice">
            🩺 隱私權說明
        </h2>

        <p class="text-center text-muted mb-4"
           data-i18n
           data-zh="請閱讀以下內容，滑至底部並勾選同意後，方可進入系統"
           data-en="Please read the following content, scroll to the bottom, and check the agreement box before entering the system.">
            請閱讀以下內容，滑至底部並勾選同意後，方可進入系統
        </p>

        @using (Html.BeginForm("PrivacyConfirm", "Public", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <!-- 捲動內容 -->
            <div id="policyContent" class="p-3 mb-3"
                 style="height: 260px; overflow-y: auto;
                            background: #f8fbff;
                            border-radius: 10px;
                            border: 1px solid #dbe9ff;">

                <p data-i18n
                   data-zh="歡迎使用 AI 智能健檢報告系統（HealthCheckAI）。本系統會蒐集並處理您的健康檢查資料，包含但不限於：檢驗數值、檢查日期、醫療院所、診斷相關資訊等，目的在於提供整合後的健康分析與醫師診斷建議。您的資料將遵循相關法規進行保存與保護：1. 僅供本系統與合作醫療人員使用。2. 系統會記錄使用紀錄以維護安全。3. 可申請查詢或刪除個人資料。使用本服務即表示您同意：本系統內容僅供參考，不取代醫療診斷；資料錯誤可能影響分析結果。"
                   data-en="Welcome to the AI Intelligent Health Check Report System (HealthCheckAI). This system collects and processes your health examination data, including but not limited to test values, examination dates, medical institutions, and diagnosis-related information. The purpose is to provide integrated health analysis and doctors’ diagnostic suggestions. Your data will be stored and protected in accordance with relevant regulations: 1. It will only be used by this system and cooperating medical personnel. 2. The system will record usage logs to maintain security. 3. You may request to review or delete your personal data. By using this service, you agree that the content is for reference only and does not replace medical diagnosis. Incorrect data may affect the analysis results.">
                    歡迎使用 AI 智能健檢報告系統（HealthCheckAI）。<br />
                    本系統會蒐集並處理您的健康檢查資料，包含但不限於：
                    檢驗數值、檢查日期、醫療院所、診斷相關資訊等，
                    目的在於提供整合後的健康分析與醫師診斷建議。<br /><br />

                    您的資料將遵循相關法規進行保存與保護：<br />
                    1️⃣ 僅供本系統與合作醫療人員使用<br />
                    2️⃣ 系統會記錄使用紀錄以維護安全<br />
                    3️⃣ 可申請查詢或刪除個人資料<br /><br />

                    使用本服務即表示您同意：<br />
                    • 僅供參考，不取代醫療診斷<br />
                    • 資料錯誤可能影響分析結果
                </p>

                <p data-i18n
                   data-zh="（以下為測試卷軸）.................... .................... 已閱讀至底部"
                   data-en="The following is for scroll testing. .................... .................... You have reached the bottom.">
                    （以下為測試卷軸）<br />
                    ....................<br />
                    ....................<br />
                    已閱讀至底部
                </p>
            </div>

            <!-- 閱讀進度條 -->
            <div class="progress mb-3" style="height:6px;">
                <div id="progressBar" class="progress-bar" style="width:0%;"></div>
            </div>

            <!-- checkbox -->
            <div class="form-check d-flex align-items-center mb-3">
                <input type="checkbox"
                       id="agreeCheckbox"
                       name="agree"
                       value="true"
                       class="form-check-input me-2"
                       style="transform: scale(1.3);" />
                <label class="form-check-label fw-semibold"
                       data-i18n
                       data-zh="我已閱讀並同意隱私權條款"
                       data-en="I have read and agree to the privacy policy.">
                    我已閱讀並同意隱私權條款
                </label>
            </div>

            <input type="hidden" name="agree" value="false" />

            <!-- 按鈕 -->
            <button type="submit"
                    id="confirmBtn"
                    class="btn w-100 fw-bold"
                    style="background: linear-gradient(135deg,#84C1FF,#4A4AFF);
                               color:white;
                               border-radius:10px;"
                    disabled>
                <span data-i18n
                      data-zh="✔ 確認並進入系統"
                      data-en="✔ Confirm and Enter System">
                    ✔ 確認並進入系統
                </span>
            </button>

            <div class="text-danger mt-2 text-center">
                @Html.ValidationSummary()
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const content = document.getElementById('policyContent');
        const checkbox = document.getElementById('agreeCheckbox');
        const btn = document.getElementById('confirmBtn');
        const progressBar = document.getElementById('progressBar');

        function updateState() {
            const maxScroll = content.scrollHeight - content.clientHeight;
            const currentScroll = content.scrollTop;

            const scrollRatio = maxScroll > 0 ? (currentScroll / maxScroll) : 1;
            const reachBottom = currentScroll + content.clientHeight >= content.scrollHeight - 5;
            const checked = checkbox.checked;

            if (progressBar) {
                progressBar.style.width = (scrollRatio * 100) + "%";
            }

            btn.disabled = !(reachBottom && checked);
        }

        content.addEventListener('scroll', updateState);
        checkbox.addEventListener('change', updateState);

        function switchLanguage(lang) {
            document.querySelectorAll("[data-i18n]").forEach(el => {
                const text = el.getAttribute(`data-${lang}`);
                if (text) {
                    el.innerText = text;
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            const savedLang = localStorage.getItem("siteLang") || "zh";
            switchLanguage(savedLang);
            updateState();
        });
    </script>
}