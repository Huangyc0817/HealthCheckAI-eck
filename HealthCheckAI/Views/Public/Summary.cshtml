    }

    .top-risk-dept {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1f3b64;
        margin-bottom: 4px;
    }

    .top-risk-en {
        color: #7c8aa5;
        font-size: 1rem;
        margin-bottom: 10px;
    }

    .top-risk-note {
        color: #495057;
        font-size: 0.85rem;
    }

    .top-risk-score {
        font-size: 1.6rem;
        font-weight: 800;
        color: #dc3545;
        line-height: 1.2;
    }

    .top-risk-grade {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f3b64;
        margin-top: 4px;
        margin-bottom: 10px;
    }

    .report-tip {
        color: #6c757d;
        font-size: 0.95rem;
