@model List<HealthCheckAI.Models.DeptSummaryViewModel>
@{
    var voiceSections =
        ViewBag.VoiceSections as Dictionary<string, string>;
}

@{
    ViewData["Title"] = "個人健康風險總覽";

    var topItem = Model
    .Where(x => !string.IsNullOrWhiteSpace(x.Severity))
    .OrderByDescending(x => x.Score)
    .FirstOrDefault();
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h2 class="health-title" data-translate>📊 個人健康風險總覽</h2>
        <div class="health-subtitle" data-translate>
            依 AI 分析結果與檢查項目風險程度排序，A 為優先關注項目
        </div>
    </div>

    @if (topItem != null)
    {
        var topGrade = GetGrade(topItem.Score);
        var topStatusClass = GetStatusClass(topItem.Severity, topItem.Score);
        var topRiskText = GetRiskText(topItem.Severity, topItem.Score);

        <div class="top-risk-card mb-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="top-risk-label" data-translate>目前最需優先留意項目</div>
                    <div class="top-risk-dept" data-translate>@topItem.Department</div>
                    <div class="top-risk-en">@topItem.EnglishName</div>
                    <div class="top-risk-note" data-translate>
                        建議優先查看此項目的 AI 分析摘要與醫師建議內容。
                    </div>

                    <div class="card mt-4 shadow-sm">
                        <div class="card-body">
                            <h5>🔊 異常值語音摘要</h5>

                            <div id="abnormalVoiceText">
                                @if (voiceSections != null)
                                {
                                    foreach (var item in voiceSections)
                                    {
                                        <div class="voice-section">

                                            <div class="voice-header">

                                                <span class="voice-title">
                                                    @item.Key
                                                </span>

                                                <button class="voice-btn"
                                                        onclick="speakText(this.closest('.voice-section').querySelector('.voice-content').innerText)">
                                                    🔊 播放此科
                                                </button>

                                            </div>

                                            <div class="voice-content">
                                                @item.Value.Trim()
                                            </div>

                                        </div>
                                    }
                                }
                            </div>

                            <button class="btn btn-primary" onclick="speakAbnormalSummary()">
                                播放語音摘要
                            </button>

                            <button class="btn btn-outline-secondary" onclick="stopSpeaking()">
                                停止播放
                            </button>
                        </div>
                    </div>
                </div>
                @{
                    var healthTrends = ViewBag.HealthTrends as List<HealthCheckAI.Models.HealthTrendViewModel>;
                }

                @if (healthTrends != null && healthTrends.Any())
                {
                    <div class="card mt-4 shadow-sm">
                        <div class="card-body">
                            <h5>📈 健康趨勢比較</h5>

                            <table class="table table-bordered mt-3">
                                <thead>
                                    <tr>
                                        <th>檢查項目</th>
                                        <th>前次風險分數</th>
                                        <th>本次風險分數</th>
                                        <th>變化</th>
                                        <th>趨勢說明</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in healthTrends)
                                    {
                                        <tr>
                                            <td>@item.Department</td>
                                            <td>@item.PreviousScore%</td>
                                            <td>@item.CurrentScore%</td>
                                            <td>@item.TrendIcon @item.Difference%</td>
                                            <td>@item.TrendText</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                <div class="col-md-4 text-center">
                    <div class="top-risk-score">@topItem.Score%</div>
                    <div class="top-risk-grade">@topGrade</div>
                    <span class="status-badge @topStatusClass" data-translate>@topRiskText</span>
                </div>
            </div>
        </div>
    }

    <div class="report-tip mb-3" data-translate>
        ※ 本排序僅供健康管理參考，實際結果仍應以醫師專業判讀為準。
    </div>

    <div class="table-responsive">
        <table class="table table-bordered align-middle table-health-ranking mt-3">
            <thead>
                <tr>
                    <th data-translate style="width:90px;">排名</th>
                    <th data-translate style="width:320px;">檢查項目</th>
                    <th data-translate>風險程度</th>
                    <th data-translate style="width:100px;">等級</th>
                    <th data-translate style="width:140px;">狀態</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    int score = item.Score;
                    bool hasData = score > 0;

                    string grade = GetGrade(hasData ? score : (int?)null);
                    string barClass = GetBarClass(item.Severity, score);
                    string riskText = GetRiskText(item.Severity, score);
                    string statusClass = GetStatusClass(item.Severity, score);
                    bool isTop = i == 0 && hasData;

                    <tr class="@(isTop ? "top-row" : "")">
                        <td class="text-center">
                            <div class="rank-badge @(isTop ? "rank-top" : "")">@(i + 1)</div>
                        </td>

                        <td>
                            <div class="dept-name" data-translate>@item.Department</div>
                            <div class="dept-en">@item.EnglishName</div>
                        </td>

                        <td style="min-width:260px;">
                            @if (hasData)
                            {
                                <div class="progress health-progress">
                                    <div class="progress-bar @barClass"
                                         role="progressbar"
                                         style="width:@score%;"
                                         aria-valuenow="@score"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        <span data-translate>@GetRiskLabel(score)</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="progress health-progress">
                                    <div class="progress-bar no-data-bar"
                                         role="progressbar"
                                         style="width:100%;">
                                        <span data-translate>尚無資料</span>
                                    </div>
                                </div>
                            }
                        </td>

                        <td class="text-center grade-cell">@grade</td>

                        <td class="text-center">
                            <span class="status-badge @statusClass" data-translate>@riskText</span>
                            <br />

                            <button class="btn btn-sm btn-outline-primary mt-2"
                                    onclick="speakSection('@item.Department')">
                                🔊 播放此科
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a class="btn btn-secondary mt-4 px-4" href="@Url.Action("Index", "Public")" data-translate>
        返回來賓主頁
    </a>
</div>

@functions {
    public string GetGrade(int? score)
    {
        if (!score.HasValue || score.Value <= 0) return "--";
        if (score.Value >= 80) return "A";
        if (score.Value >= 65) return "B";
        if (score.Value >= 50) return "C";
        if (score.Value >= 35) return "D";
        if (score.Value >= 20) return "E";
        return "F";
    }

    public string GetBarClass(string severity, int score)
    {
        if (score <= 0) return "bg-secondary-subtle text-secondary";
        if (score >= 80) return "bg-danger";
        if (score >= 50) return "bg-warning text-dark";
        return "bg-info";
    }

    public string GetRiskText(string severity, int score)
    {
        if (score <= 0) return "尚無資料";
        if (score >= 80) return "高風險";
        if (score >= 50) return "中風險";
        return "低風險";
    }

    public string GetStatusClass(string severity, int score)
    {
        if (score <= 0) return "status-none";
        if (score >= 80) return "status-high";
        if (score >= 50) return "status-medium";
        return "status-low";
    }

    public string GetRiskLabel(int score)
    {
        if (score <= 0) return "尚無資料";
        if (score >= 80) return $"高（{score}%）";
        if (score >= 50) return $"中（{score}%）";
        return $"低（{score}%）";
    }

    
}

<script>
    const voiceSections = {
        @if (voiceSections != null)
    {
        foreach (var item in voiceSections)
        {
            <text>
                            "@item.Key": `@Html.Raw(item.Value.Replace("`", "\\`"))`,
            </text>
        }
    }
    };

    function normalizeForSpeech(text) {
        return text
            .replace(/（[A-Za-z\s\-\/]+）/g, "")
            .replace(/\([A-Za-z\s\-\/]+\)/g, "")
            .replace(/BMI/g, "身體質量指數")
            .replace(/HbA1c/g, "糖化血色素")
            .replace(/mmHg/g, "毫米汞柱")
            .replace(/ECG/g, "心電圖")
            .replace(/【/g, "")
            .replace(/】/g, "。")
            .replace(/\//g, "或")
            .replace(/／/g, "或")
            .replace(/[()（）]/g, "")
            .replace(/</g, "小於")
            .replace(/>/g, "大於")
            .replace(/---/g, "")
            .replace(/\d+\./g, "")
            .replace(/[:：]/g, "，")
            .replace(/、/g, "，")
            .replace(/\s+/g, " ")
            .trim();
    }

    function speakText(rawText) {
        if (!rawText || !rawText.trim()) {
            alert("目前沒有可朗讀的異常摘要");
            return;
        }

        window.speechSynthesis.cancel();

        const text = normalizeForSpeech(rawText);
        const speech = new SpeechSynthesisUtterance(text);

        speech.lang = "zh-TW";
        speech.rate = 0.9;
        speech.pitch = 1;

        window.speechSynthesis.speak(speech);
    }

    function speakAbnormalSummary() {
        const contents = document.querySelectorAll("#abnormalVoiceText .voice-content");

           let rawText =
    "這是您的本次健康檢查異常值語音摘要。\n\n";

    contents.forEach(x => {
        rawText += x.innerText + "\n\n";
    });

    rawText += "以上內容僅供參考，實際結果請依醫師說明為準。";

        if (!rawText.trim()) {
            alert("目前沒有可朗讀的異常摘要");
            return;
        }

        speakText(rawText);
    }

    function speakSection(dept) {
        const rawText = voiceSections[dept];

        if (!rawText) {
            alert("目前沒有此科語音摘要");
            return;
        }

        speakText(rawText);
    }

    function stopSpeaking() {
        window.speechSynthesis.cancel();
    }
</script>

