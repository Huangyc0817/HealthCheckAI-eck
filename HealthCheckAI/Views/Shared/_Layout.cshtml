<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HealthCheckAI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HealthCheckAI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">HealthCheckAI</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>


                    @{
                        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                    }

                    @if (controller == "Public")
                    {
                        <div class="d-flex align-items-center ms-2">
                            <button id="btnGlobalTranslate" class="btn btn-outline-primary btn-sm" type="button">
                                翻譯成英文
                            </button>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - HealthCheckAI - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const LANG_KEY = "public_lang";

        function getLang() {
            return localStorage.getItem(LANG_KEY) || "zh";
        }

        function setLang(lang) {
            localStorage.setItem(LANG_KEY, lang);
        }

        async function translateText(text, target) {
            text = normalizeMedicalText(text);

            const resp = await fetch("/api/translate", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    text: text,
                    source: "zh",
                    target: target
                })
            });

            if (!resp.ok) throw new Error("translate failed");

            const data = await resp.json();
            return data.translatedText || "";
        }

        function normalizeMedicalText(text) {
            return text
                .replace(/公分/g, "cm")
                .replace(/公斤/g, "kg")
                .replace(/次\/分鐘/g, "beats/min")
                .replace(/小於/g, "less than")
                .replace(/國人標準/g, "National standard")
                .replace(/女性標準/g, "Female standard")
                .replace(/體格檢查表/g, "Physical Exam")
                .replace(/理學檢查/g, "Physical Examination")
                .replace(/眼科檢查/g, "Ophthalmologic Exam")
                .replace(/靜態心電圖/g, "Resting ECG")
                .replace(/實驗室檢查/g, "Laboratory Tests")
                .replace(/精密儀器檢查/g, "Imaging / Instrument Exam")
                .replace(/身高/g, "Body height")
                .replace(/體重/g, "Body weight")
                .replace(/腹圍/g, "Abdominal girth")
                .replace(/脈搏/g, "Pulse rate")
                .replace(/血壓/g, "Blood pressure")
                .replace(/參考值/g, "Reference")
                .replace(/結果/g, "Result")
                .replace(/項目/g, "Item");
        }

        async function applyPageTranslation() {
            const lang = getLang();
            const btn = document.getElementById("btnGlobalTranslate");

            if (btn) {
                btn.textContent = lang === "en" ? "翻譯成中文" : "翻譯成英文";
            }

            const nodes = Array.from(document.querySelectorAll("[data-translate], .translate-target"));

            for (const el of nodes) {
                if (!el.dataset.original) {
                    el.dataset.original = el.innerText;
                }
            }

            if (lang === "zh") {
                for (const el of nodes) {
                    el.innerText = el.dataset.original;
                }
                return;
            }

            const cache = new Map();

            for (const el of nodes) {
                const src = el.dataset.original;
                if (!src || !src.trim()) continue;

                if (cache.has(src)) {
                    el.innerText = cache.get(src);
                    continue;
                }

                const translated = await translateText(src, "en");
                cache.set(src, translated);
                el.innerText = translated;
            }
        }

       document.addEventListener("DOMContentLoaded", function () {
            if (!localStorage.getItem(LANG_KEY)) {
                setLang("zh");
            }

            const btn = document.getElementById("btnGlobalTranslate");

            if (btn) {
                btn.addEventListener("click", async function () {
                    btn.disabled = true;

                    try {
                        setLang(getLang() === "en" ? "zh" : "en");
                        await applyPageTranslation();
                    } finally {
                        btn.disabled = false;
                    }
                });
            }

            applyPageTranslation();
        });
    </script>
  
</body>
</html>
